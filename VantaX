-- Cleanup (re-running the script cleans up the previous instance)
-- ------------------------------------------------------------
env.__MM2_CLEANUP = function()
    pcall(saveSettings)   -- first: the resets below must not be saved
    alive = false
    pcall(function() RunService:UnbindFromRenderStep(AIM_BIND) end)
    S.silent = false
    SIL.lock = false
    env.__MM2_SIL = nil   -- hooks that stay installed become pass-through
    S.speed, S.jump, S.fly, S.noclip, S.coins, S.gun = false, false, false, false, false, false
    FORCE.role = nil
    S.fullbright = false
    if curTween then pcall(function() curTween:Cancel() end) end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(flyOff)
    if wasNoclip then
        wasNoclip = false
        pcall(restoreCollision)
    end
    pcall(applyLighting)
    pcall(clearAll)
    pcall(clearCoinMarks)
    if gunHl then pcall(function() gunHl:Destroy() end) end
    local _, hum = myParts()
    if hum then
        pcall(function()
            hum.WalkSpeed = 16
            hum.JumpPower = 50
        end)
    end
    pcall(ui.destroy)
    pcall(function() fovGui:Destroy() end)
    env.__MM2_CLEANUP = nil
end

