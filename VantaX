-- player names for the picker: "DisplayName (@username)", or just the name when both are equal
local function playerLabel(plr)
    if plr.DisplayName ~= plr.Name then return plr.DisplayName .. " (@" .. plr.Name .. ")" end
    return plr.Name
end

local function playerLabels()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then list[#list + 1] = playerLabel(plr) end
    end
    table.sort(list, function(a, b) return a:lower() < b:lower() end)
    if #list == 0 then list[1] = "(no players)" end
    return list
end

local function playerByLabel(label)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and playerLabel(plr) == label then return plr end
    end
    return nil
end

local function pickPlayer(label)
    S.flingPick = label
    FLING.sel = playerByLabel(label)
    showSelected()
end

-- re-reads the player list into the dropdown. Slate's dropdown API is not documented, so a few common
-- method names are tried; if none of them exists the list stays as it was when the menu opened
-- (the Next / Previous Player buttons always use the live list).
local function refreshPlayerList()
    local names = playerLabels()
    if PLAYER_DD then
        for _, m in ipairs({ "Refresh", "SetOptions", "UpdateOptions", "SetValues", "SetList" }) do
            local fn = PLAYER_DD[m]
            if type(fn) == "function" and pcall(fn, PLAYER_DD, names) then break end
        end
    end
    if not (FLING.sel and FLING.sel.Parent) then
        S.flingPick = names[1]
        FLING.sel = playerByLabel(names[1])
    end
    showSelected()
    return playerByLabel(names[1]) and #names or 0
end

