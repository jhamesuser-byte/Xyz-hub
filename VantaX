        if w then
            btn("VX", -50, function()
                shown = not shown
                w:SetVisible(shown)
            end)
        end
        btn("LT", 4, function()
            local l = openLite()
            if l then l.toggle() end
        end)
        mount(g, true)
    end)
end

local function fail(msg)
    say("FALHA: " .. tostring(msg):sub(1, 300))
    pcall(function()
        if env.__VORTEX_HUB_CLEANUP then env.__VORTEX_HUB_CLEANUP() end
    end)
    local l = openLite()
    if l then
        l.show(true)
        say("menu LITE aberto. Toque no log para fechar.")
    end
    addDock(nil)
end

