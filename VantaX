-- protection (defensive, local only)
-- Anti Fling: nearby players' body parts stop colliding with you, so they cannot push or spin you.
-- Their collision stays off locally until their character respawns, even after you turn this off.
track(RunService.Stepped:Connect(function()
    if not S.antiFling or FLING.busy then return end
    local _, _, root = myParts()
    if not root then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            local c = plr.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if r and (r.Position - root.Position).Magnitude < CFG.flingRange then
                for _, p in ipairs(c:GetChildren()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end
        end
    end
end))

-- Anti Fling (speed guard) + Anti Void: remember the last normal position and snap back to it
local safeCF
track(RunService.Heartbeat:Connect(function()
    local _, hum, root = myParts()
    if not hum or not root or hum.Health <= 0 then
        safeCF = nil
        return
    end
    if FLING.busy then return end   -- our own fling: do not snap back
    local flung = S.antiFling and not S.fly
        and (root.AssemblyLinearVelocity.Magnitude > CFG.maxVelocity
            or root.AssemblyAngularVelocity.Magnitude > CFG.maxSpin)
    local voided = S.antiVoid and root.Position.Y < workspace.FallenPartsDestroyHeight + CFG.voidMargin
    if flung or voided then
        if safeCF then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = safeCF
        end
    else
        safeCF = root.CFrame
    end
end))

-- ------------------------------------------------------------
-- Cleanup (re-running the script cleans up the previous instance)
-- ------------------------------------------------------------
env.__MM2_CLEANUP = function()
    pcall(saveSettings)   -- first: the resets below must not be saved
    alive = false
    FLING.stop = true
    S.silent = false
    SIL.lock = false
    env.__MM2_SIL3 = nil   -- hooks that stay installed become pass-through
    S.speed, S.jump, S.fly, S.noclip, S.coins, S.gun = false, false, false, false, false, false
    endAutoShot()
    pcall(function() RunService:UnbindFromRenderStep(RS_NAME) end)
    S.fullbright = false
    if curTween then pcall(function() curTween:Cancel() end) end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(flyOff)
    if wasNoclip then
        wasNoclip = false
        pcall(restoreCollision)
    end
    pcall(applyLighting)
    pcall(clearAll)
    pcall(clearCoinMarks)
    if gunHl then pcall(function() gunHl:Destroy() end) end
    local _, hum = myParts()
    if hum then
        pcall(function()
            hum.WalkSpeed = 16
            hum.JumpPower = 50
        end)
    end
    pcall(ui.destroy)
    pcall(function() fovGui:Destroy() end)
    pcall(function() quickGui:Destroy() end)
    env.__MM2_CLEANUP = nil
end

