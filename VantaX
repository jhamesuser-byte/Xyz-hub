-- combate: auto equipar, auto tiro, kill aura
task.spawn(function()
    local lastShot = 0
    while alive do
        local char, hum, root = myParts()
        if char and hum and hum.Health > 0 and root then
            local myRole = roleOf(lp)

            if S.autoEquip and not char:FindFirstChildOfClass("Tool") then
                if myRole == "Xerife" then equip("Gun")
                elseif myRole == "Assassino" then equip("Knife") end
            end

            if S.autoShoot and myRole == "Xerife" and os.clock() - lastShot > 0.6 then
                local ok, part = pcall(pickTarget, S.silentFov, S.maxDist, S.silentPart, true, 0)
                if ok and part then
                    local gun = equip("Gun")
                    if gun then
                        lastShot = os.clock()
                        pcall(function() gun:Activate() end)
                    end
                end
            end

            if S.aura and myRole == "Assassino" then
                local best, bd
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= lp then
                        local c = plr.Character
                        local h = c and c:FindFirstChildOfClass("Humanoid")
                        local r = c and c:FindFirstChild("HumanoidRootPart")
                        if h and r and h.Health > 0 then
                            local d = (r.Position - root.Position).Magnitude
                            if d <= S.auraRange and (not bd or d < bd) then
                                best, bd = r, d
                            end
                        end
                    end
                end
                if best then
                    local knife = equip("Knife")
                    if knife then
                        if S.auraTp and bd > 4 then
                            local behind = (best.CFrame * CFrame.new(0, 0, 3)).Position
                            root.CFrame = CFrame.lookAt(behind, best.Position)
                        else
                            root.CFrame = CFrame.lookAt(root.Position,
                                Vector3.new(best.Position.X, root.Position.Y, best.Position.Z))
                        end
                        pcall(function() knife:Activate() end)
                    end
                end
            end
        end
        task.wait(0.12)
    end
end)

-- auto-moedas (tween ate a moeda mais proxima)
task.spawn(function()
    while alive do
        if S.coins then
            local _, hum, root = myParts()
            if root and hum and hum.Health > 0 then
                local coin, dist = nearestCoin(root)
                if coin and coin.Parent then
                    local goal = CFrame.new(coin.Position) * root.CFrame.Rotation
                    curTween = TweenService:Create(root,
                        TweenInfo.new(math.max(dist / S.coinSpeed, 0.1), Enum.EasingStyle.Linear),
                        { CFrame = goal })
                    curTween:Play()
                    curTween.Completed:Wait()
                    curTween = nil
                    if touch and coin.Parent then
                        pcall(touch, root, coin, 0)
                        pcall(touch, root, coin, 1)
                    end
                    task.wait(0.15)
                else
                    task.wait(0.5)
                end
            else
                task.wait(0.5)
            end
        else
            task.wait(0.3)
        end
    end
end)

