-- HTTP with fallback (some executors do not have game:HttpGet)
local function httpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" and #res > 0 then return res end
    local req = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
    if req then
        local ok2, r = pcall(req, { Url = url, Method = "GET" })
        if ok2 and type(r) == "table" and type(r.Body) == "string" and #r.Body > 0
            and (r.Success == true or r.StatusCode == 200) then
            return r.Body
        end
    end
    error("HttpGet failed: " .. tostring(res))
end

-- ------------------------------------------------------------
-- Utilities
-- ------------------------------------------------------------
local function myParts()
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    return char, hum, root
end

local function hasTool(plr, name)
    local bp = plr:FindFirstChildOfClass("Backpack")
    if bp and bp:FindFirstChild(name) then return true end
    local c = plr.Character
    return c ~= nil and c:FindFirstChild(name) ~= nil
end

local function roleOf(plr)
    if hasTool(plr, "Knife") then return "Murderer" end
    if hasTool(plr, "Gun") then return "Sheriff" end
    return "Innocent"
end

local ROLE = {}
local function roleCached(plr)
    return ROLE[plr] or roleOf(plr)
end

local function equip(name)
    local char, hum = myParts()
    if not char or not hum then return nil end
    local t = char:FindFirstChild(name)
    if t and t:IsA("Tool") then return t end
    local bp = lp:FindFirstChildOfClass("Backpack")
    local bt = bp and bp:FindFirstChild(name)
    if bt and bt:IsA("Tool") then
        hum:EquipTool(bt)
        return bt
    end
    return nil
end

-- coin container (cached: a recursive workspace search is expensive)
local cc, ccT = nil, 0
local function coinContainer()
    if cc and cc.Parent then return cc end
    if os.clock() - ccT < 1 then return nil end
    ccT = os.clock()
    cc = workspace:FindFirstChild("CoinContainer", true)
    return cc
end

-- ------------------------------------------------------------
-- Target selection (aimbot / silent aim / auto shoot)
-- ------------------------------------------------------------
local PARTS = {
    Head = { "Head" },
    Torso  = { "UpperTorso", "Torso", "HumanoidRootPart" },
}

local function partOf(char, key)
    for _, n in ipairs(PARTS[key] or PARTS.Head) do
        local p = char:FindFirstChild(n)
        if p and p:IsA("BasePart") then return p end
    end
    return char:FindFirstChild("HumanoidRootPart")
end

-- set by "Shoot Murderer": forces the target role regardless of the Target setting
local FORCE = { role = nil }

local function wantRole(role, myRole)
    if FORCE.role then return role == FORCE.role end
    local a = CFG.target
    if a == "All" then return true end
    if a == "Murderer" then return role == "Murderer" end
    if a == "Sheriff" then return role == "Sheriff" end
    -- Auto: the murderer targets everyone; everyone else targets the murderer
    if myRole == "Murderer" then return true end
    return role == "Murderer"
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- dot-call (workspace.Raycast(workspace, ...)) does not go through the __namecall hook
local function visible(cam, part, char)
    rayParams.FilterDescendantsInstances = { lp.Character, char, cam }
    local origin = cam.CFrame.Position
    local hit = workspace.Raycast(workspace, origin, part.Position - origin, rayParams)
    return hit == nil
end

local function pickTarget(fov, maxDist, partKey, wall)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local _, myHum = myParts()
    if not myHum or myHum.Health <= 0 then return nil end
    local myRole = roleOf(lp)
    local center = cam.ViewportSize / 2
    local camPos = cam.CFrame.Position
    local bestPart, bestPlr
    local bestKey = math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if char and hum and hum.Health > 0 and wantRole(roleCached(plr), myRole) then
                local part = partOf(char, partKey)
                if part then
                    local dist = (part.Position - camPos).Magnitude
                    if dist <= maxDist then
                        local sp, on = cam:WorldToViewportPoint(part.Position)
                        if on and sp.Z > 0 then
                            local dd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if dd <= fov then
                                local key = (CFG.prio == "Closest") and dist or dd
                                if key < bestKey and ((not wall) or visible(cam, part, char)) then
                                    bestKey, bestPart, bestPlr = key, part, plr
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if not bestPart then return nil end
    return bestPart, bestPart.Position, bestPlr
end

-- ------------------------------------------------------------
-- Silent Aim (hooks) - state shared with the hooks via env.__MM2_SIL
-- ------------------------------------------------------------
-- mode is fixed to "All" (Raycast + Remote + Mouse); kept only so hooks left over from an older run keep working
local SIL = {
    lock = false, pos = Vector3.zero, part = nil, mode = "All", hit = 100,
    camPos = Vector3.zero, rootPos = Vector3.zero, mouse = nil,
}
pcall(function() SIL.mouse = lp:GetMouse() end)
env.__MM2_SIL = SIL

function SIL.near(origin)
    return (origin - SIL.camPos).Magnitude < 20 or (origin - SIL.rootPos).Magnitude < 20
end

function SIL.roll()
    return SIL.hit >= 100 or math.random(1, 100) <= SIL.hit
end

-- IMPORTANT: inside the hooks do not use colon calls (inst:Method()): that overwrites the pending
-- namecall name and the original method would run wrong. Property reads only.
-- Weapon remote (Gun/Knife): swaps the aim Vector3/CFrame for the target (experimental heuristic)
function SIL.remote(remote, ...)
    local p, isWeapon = remote, false
    for _ = 1, 3 do
        p = p and p.Parent
        if p and (p.Name == "Gun" or p.Name == "Knife") then
            isWeapon = true
            break
        end
    end
    if not isWeapon or not SIL.roll() then return nil end
    local args = table.pack(...)
    local changed = false
    for i = 1, args.n do
        local a = args[i]
        local t = typeof(a)
        if t == "Vector3" then
            args[i] = SIL.pos
            changed = true
        elseif t == "CFrame" then
            local ap = a.Position
            if (ap - SIL.rootPos).Magnitude > 15 then
                args[i] = CFrame.new(SIL.pos)
            else
                args[i] = CFrame.lookAt(ap, SIL.pos)
            end
            changed = true
        end
    end
    if changed then return args end
    return nil
end

local function ours()
    return typeof(checkcaller) == "function" and checkcaller()
end

local function installHooks()
    if typeof(hookmetamethod) ~= "function" or typeof(getnamecallmethod) ~= "function" then
        return false
    end
    local wrap = (typeof(newcclosure) == "function") and newcclosure or function(f) return f end

    if not env.__MM2_NC then
        env.__MM2_NC = true
        local old
        old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
            local m = getnamecallmethod()
            local st = env.__MM2_SIL
            if st and st.lock and not ours() then
                if self == workspace then
                    if m == "Raycast" then
                        local origin, direction, params = ...
                        if typeof(origin) == "Vector3" and typeof(direction) == "Vector3"
                            and st.near(origin) and st.roll() then
                            local d = st.pos - origin
                            if d.Magnitude > 0.001 then
                                return old(self, origin, d.Unit * direction.Magnitude, params)
                            end
                        end
                    elseif m == "FindPartOnRay" or m == "FindPartOnRayWithIgnoreList"
                        or m == "FindPartOnRayWithWhitelist" then
                        local ray = ...
                        if typeof(ray) == "Ray" and st.near(ray.Origin) and st.roll() then
                            local d = st.pos - ray.Origin
                            if d.Magnitude > 0.001 then
                                return old(self, Ray.new(ray.Origin, d.Unit * ray.Direction.Magnitude), select(2, ...))
                            end
                        end
                    end
                end
                if m == "FireServer" then
                    local packed = st.remote(self, ...)
                    if packed then
                        if typeof(setnamecallmethod) == "function" then setnamecallmethod(m) end
                        return old(self, table.unpack(packed, 1, packed.n))
                    end
                end
            end
            return old(self, ...)
        end))
    end

    if not env.__MM2_IX then
        env.__MM2_IX = true
        local oldIndex
        oldIndex = hookmetamethod(game, "__index", wrap(function(self, key)
            local st = env.__MM2_SIL
            if st and st.lock and st.mouse and self == st.mouse
                and (key == "Hit" or key == "Target") and not ours() then
                if st.roll() then
                    if key == "Hit" then return CFrame.new(st.pos) end
                    return st.part
                end
            end
            return oldIndex(self, key)
        end))
    end
    return true
end

local function computeSilent()
    SIL.lock = false
    SIL.hit = FORCE.role and 100 or S.silentHit
    if not (S.silent or FORCE.role) then return end
    local cam = workspace.CurrentCamera
    local char, hum, root = myParts()
    if not cam or not char or not hum or hum.Health <= 0 then return end
    if not FORCE.role and not char:FindFirstChildOfClass("Tool") then return end
    SIL.camPos = cam.CFrame.Position
    SIL.rootPos = root and root.Position or SIL.camPos
    local part, pos
    if FORCE.role then
        part, pos = pickTarget(5000, 5000, "Torso", false)
    else
        part, pos = pickTarget(S.silentFov, CFG.maxDist, CFG.silentPart, CFG.wall)
    end
    if part then
        SIL.lock = true
        SIL.pos = pos
        SIL.part = part
    end
end

