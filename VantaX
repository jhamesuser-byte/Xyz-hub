-- Loops
-- ------------------------------------------------------------
-- Protected loop: an error in one pass is logged (at most every 5 s) instead of killing the loop.
-- fn may return a number of seconds to wait before the next pass (default: interval).
local function loop(interval, fn)
    task.spawn(function()
        local lastWarn = 0
        while alive do
            local ok, res = pcall(fn)
            if not ok and os.clock() - lastWarn > 5 then
                lastWarn = os.clock()
                warn("[MM2 Hub] " .. tostring(res))
            end
            task.wait((ok and type(res) == "number") and res or interval)
        end
    end)
end

