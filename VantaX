-- mode is fixed to "All" (Raycast + Remote + Mouse); kept only so hooks left over from an older run keep working
local SIL = {
    lock = false, pos = Vector3.zero, part = nil, mode = "All", hit = 100,
    camPos = Vector3.zero, rootPos = Vector3.zero, mouse = nil, cam = nil,
    held = nil, forced = false, shotUntil = 0,
    learnThrow = false, throwSeen = nil, throwByName = false,   -- Throw Knife: the game's own throw call, recorded
}
pcall(function() SIL.mouse = lp:GetMouse() end)
env.__MM2_SIL = nil    -- hooks left over from older versions read this key: they become pass-through
env.__MM2_SIL3 = SIL

function SIL.near(origin)
    return (origin - SIL.camPos).Magnitude < 20 or (origin - SIL.rootPos).Magnitude < 20
end

-- Silent Aim must not touch anything between shots (camera occlusion, movement and UI scripts use the same
-- calls). The hooks act only inside a short window opened by a click/tap or a tool activation, or during a
-- forced shot (Shoot Murderer / Auto Shoot / on-screen button).
function SIL.active()
    return SIL.forced or os.clock() < SIL.shotUntil
end

local function openShotWindow()
    SIL.shotUntil = os.clock() + 0.4
end
track(UIS.InputBegan:Connect(function(input)
    local t = input.UserInputType
    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then openShotWindow() end
end))
local function watchCharacter(char)
    if not char then return end
    local function watch(c)
        if c:IsA("Tool") then track(c.Activated:Connect(openShotWindow)) end
    end
    for _, c in ipairs(char:GetChildren()) do watch(c) end
    track(char.ChildAdded:Connect(watch))
end
watchCharacter(lp.Character)
track(lp.CharacterAdded:Connect(watchCharacter))

-- Hit chance is fixed at 100%: every hooked call of a shot is redirected
function SIL.roll()
    return true
end

-- IMPORTANT: inside the hooks do not use colon calls (inst:Method()): that overwrites the pending
-- namecall name and the original method would run wrong. Property reads only.
-- Weapon remote (Gun/Knife): swaps the aim Vector3/CFrame for the target (experimental heuristic)
function SIL.remote(remote, ...)
    local p, isWeapon = remote, false
    for _ = 1, 3 do
        p = p and p.Parent
        if p and (p.Name == "Gun" or p.Name == "Knife") then
            isWeapon = true
            break
        end
    end
    if not isWeapon or not SIL.roll() then return nil end
    local args = table.pack(...)
    local nCF = 0
    for i = 1, args.n do
        if typeof(args[i]) == "CFrame" then nCF = nCF + 1 end
    end
    local changed, seen = false, 0
    for i = 1, args.n do
        local a = args[i]
        local t = typeof(a)
        if t == "Vector3" then
            args[i] = SIL.pos
            changed = true
        elseif t == "CFrame" then
            seen = seen + 1
            local ap = a.Position
            -- 2+ CFrames: the first is the origin (keep its position, point it at the target) and the
            -- last is the aim target. A single CFrame: far from the player = target, close = origin.
            local isTarget
            if nCF >= 2 then
                isTarget = (seen == nCF)
            else
                isTarget = (ap - SIL.rootPos).Magnitude > 15
            end
            if isTarget then
                args[i] = CFrame.new(SIL.pos)
            else
                args[i] = CFrame.lookAt(ap, SIL.pos)
            end
            changed = true
        end
    end
    if changed then return args end
    return nil
end

-- True when the remote sits inside the Knife tool and looks like the throw: its name contains "throw"
-- (second result true), or it carries a position argument (second result false).
function SIL.isKnifeThrow(remote, ...)
    local p, inKnife = remote, false
    for _ = 1, 5 do
        p = p and p.Parent
        if p and p.Name == "Knife" then
            inKnife = true
            break
        end
    end
    if not inKnife then return false end
    if string.find(string.lower(remote.Name), "throw", 1, true) then return true, true end
    for i = 1, select("#", ...) do
        local t = typeof((select(i, ...)))
        if t == "CFrame" or t == "Vector3" then return true, false end
    end
    return false
end

local function ours()
    return typeof(checkcaller) == "function" and checkcaller()
end

local function installHooks()
    if typeof(hookmetamethod) ~= "function" or typeof(getnamecallmethod) ~= "function" then
        return false
    end
    local wrap = (typeof(newcclosure) == "function") and newcclosure or function(f) return f end

    if not env.__MM2_NC3 then
        env.__MM2_NC3 = true
        local old
        old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
            local m = getnamecallmethod()
            local st = env.__MM2_SIL3
            if st and st.learnThrow and (m == "FireServer" or m == "InvokeServer") then
                local isThrow, byName = st.isKnifeThrow(self, ...)
                if isThrow and (byName or not st.throwByName) and not ours() then
                    st.throwSeen = table.pack(self, m, ...)   -- remote, method, then the arguments
                    st.throwByName = byName
                end
                if typeof(setnamecallmethod) == "function" then setnamecallmethod(m) end
            end
            if st and st.lock and st.active() and not ours() then
                if self == workspace then
                    if m == "Raycast" then
                        local origin, direction, params = ...
                        if typeof(origin) == "Vector3" and typeof(direction) == "Vector3"
                            and direction.Magnitude >= CFG.minRayLen and st.near(origin) and st.roll() then
                            local d = st.pos - origin
                            if d.Magnitude > 0.001 then
                                return old(self, origin, d.Unit * direction.Magnitude, params)
                            end
                        end
                    elseif m == "FindPartOnRay" or m == "FindPartOnRayWithIgnoreList"
                        or m == "FindPartOnRayWithWhitelist" then
                        local ray = ...
                        if typeof(ray) == "Ray" and ray.Direction.Magnitude >= CFG.minRayLen
                            and st.near(ray.Origin) and st.roll() then
                            local d = st.pos - ray.Origin
                            if d.Magnitude > 0.001 then
                                return old(self, Ray.new(ray.Origin, d.Unit * ray.Direction.Magnitude), select(2, ...))
                            end
                        end
                    end
                end
                if (m == "ViewportPointToRay" or m == "ScreenPointToRay") and self == st.cam and st.roll() then
                    local d = st.pos - st.camPos
                    if d.Magnitude > 0.001 then
                        return Ray.new(st.camPos, d.Unit)
                    end
                end
                if m == "FireServer" or m == "InvokeServer" then
                    local packed = st.remote(self, ...)
                    if packed then
                        if typeof(setnamecallmethod) == "function" then setnamecallmethod(m) end
                        return old(self, table.unpack(packed, 1, packed.n))
                    end
                end
            end
            return old(self, ...)
        end))
    end

    if not env.__MM2_IX3 then
        env.__MM2_IX3 = true
        local oldIndex
        oldIndex = hookmetamethod(game, "__index", wrap(function(self, key)
            local st = env.__MM2_SIL3
            if st and st.lock and st.active() and st.mouse and self == st.mouse
                and (key == "Hit" or key == "Target") and not ours() then
                if st.roll() then
                    if key == "Hit" then return CFrame.new(st.pos) end
                    return st.part
                end
            end
            return oldIndex(self, key)
        end))
    end
    return true
end

local function computeSilent()
    SIL.lock = false
    SIL.forced = FORCE.role ~= nil
    if not (S.silent or FORCE.role) then
        SIL.held = nil
        return
    end
    local cam = workspace.CurrentCamera
    local char, hum, root = myParts()
    if not cam or not char or not hum or hum.Health <= 0 then return end
    if not FORCE.role and not char:FindFirstChildOfClass("Tool") then return end
    SIL.cam = cam
    SIL.camPos = cam.CFrame.Position
    SIL.rootPos = root and root.Position or SIL.camPos
    local part, pos
    if FORCE.role then
        if FORCE.part and FORCE.part.Parent then
            part, pos = FORCE.part, FORCE.part.Position
        else
            part, pos = pickTarget(math.huge, math.huge, "Torso", false)
        end
    else
        -- keep the current target while it stays valid, so the lock does not jump between players
        local held = SIL.held
        if held and holdTarget(cam, held, S.silentFov) and partOf(held.Parent, S.silentPart) == held then
            part, pos = held, held.Position
        else
            part, pos = pickTarget(S.silentFov, CFG.maxDist, S.silentPart, CFG.wall)
        end
        SIL.held = part
    end
    if part then
        SIL.lock = true
        SIL.pos = pos
        SIL.part = part
    end
end

