    Info = Color3.fromRGB(130, 170, 255),
}

local function buildSlate()
    local okH, src = pcall(httpGet, SLATE_URL)
    if not okH then return nil, "downloading Slate: " .. tostring(src) end
    local fn, err = loadstring(src, "@Slate")
    if not fn then return nil, "compiling Slate: " .. tostring(err) end
    local okL, Slate = pcall(fn)
    if not okL or not Slate then return nil, "loading Slate: " .. tostring(Slate) end

    pcall(function() Slate:PreloadIcons({ "lucide" }) end)
    pcall(function() if Slate.Theme and Slate.Theme.Set then Slate.Theme:Set(THEME) end end)
    pcall(function() Slate.Theme.Preset("Violet") end)
    pcall(function() Slate:SetFontFamily("JosefinSans") end)

    local okW, win = pcall(function()
        return Slate:CreateWindow({
            Name = "MM2 Hub", Subtitle = "Murder Mystery 2", Icon = "crown", Logo = true,
            Size = UDim2.fromOffset(520, 340), MinSize = Vector2.new(420, 300),
            ToggleKey = Enum.KeyCode.RightShift,
        })
    end)
    if not okW or not win then return nil, "creating the window: " .. tostring(win) end
    pcall(function() win:SetBackdrop("aurora") end)

    local created = 0
    for _, t in ipairs(UI) do
        -- a tab with an icon Slate does not know must not disappear: retry without the icon
        local okT, tab = pcall(function() return win:CreateTab({ Name = t.tab, Icon = t.icon }) end)
        if not (okT and tab) then
            okT, tab = pcall(function() return win:CreateTab({ Name = t.tab }) end)
        end
        if okT and tab then
            pcall(function() tab:SetColumns(2) end)
            for _, sec in ipairs(t.sections) do
                local okS, section = pcall(function() return tab:CreateSection({ Name = sec.name }) end)
                if okS and section then
                    for _, it in ipairs(sec.items) do
                        local kind = it[1]
                        local okI = pcall(function()
                            if kind == "toggle" then
                                local key, cb = it[3], it[4]
                                section:Toggle({
                                    Name = it[2], Default = S[key],
                                    Callback = function(v)
                                        S[key] = (v == true)
                                        if cb then pcall(cb, S[key]) end
                                    end,
                                })
                            elseif kind == "slider" then
                                local key, cb = it[3], it[7]
                                section:Slider({
                                    Name = it[2], Min = it[4], Max = it[5], Default = S[key],
                                    Callback = function(v)
                                        S[key] = math.floor((tonumber(v) or S[key]) + 0.5)
                                        if cb then pcall(cb, S[key]) end
                                    end,
                                })
                            elseif kind == "drop" then
                                local key, cb = it[3], it[5]
                                section:Dropdown({
                                    Name = it[2], Options = it[4], Default = S[key],
                                    Callback = function(v)
                                        S[key] = v
                                        if cb then pcall(cb, v) end
                                    end,
                                })
                            elseif kind == "button" then
                                local cb = it[3]
                                section:Button({ Name = it[2], Callback = function() pcall(cb) end })
                            elseif kind == "label" then
                                local lbl = section:Label({ Name = it[2] })
                                INFO[it[3]] = function(text) pcall(function() lbl:Set(text, true) end) end
                            end
                        end)
                        if okI then created = created + 1 end
                    end
                end
            end
        end
    end
    if created == 0 then
        pcall(function() win:Destroy() end)
        return nil, "Slate did not create any controls"
    end

    local shown = true
    pcall(function() win:SetVisible(true) end)
    return {
        toggle = function()
            shown = not shown
            pcall(function() win:SetVisible(shown) end)
        end,
        destroy = function() pcall(function() win:Destroy() end) end,
    }
end

