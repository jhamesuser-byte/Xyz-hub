-- ------------------------------------------------------------
-- Notifications: toasts stacked in the top-right corner (slide in, timer bar, click to dismiss)
-- notify(msg, kind, title): kind = "info" | "success" | "warn" | "error" | "murderer" | "sheriff";
-- without a kind it is guessed from the text.
-- ------------------------------------------------------------
local NOTIFY = { gui = nil, list = nil, order = 0, last = {} }
local notify
do
    local WIDTH, MAX = 215, 4
    local KINDS = {
        info     = { color = Color3.fromRGB(168, 100, 255), title = "MM2 Hub" },
        success  = { color = Color3.fromRGB(190, 140, 255), title = "Success" },
        warn     = { color = Color3.fromRGB(140, 90, 230),  title = "Notice" },
        error    = { color = Color3.fromRGB(125, 70, 215),  title = "Error" },
        murderer = { color = COLORS.Murderer,               title = "Murderer" },
        sheriff  = { color = COLORS.Sheriff,                title = "Sheriff" },
    }

    local function guessKind(msg)
        local m = msg:lower()
        if m:find("error", 1, true) then return "error" end
        for _, w in ipairs({ "not found", "no ", "failed", "could not", "unavailable", "invalid", "not ready",
            "not available", "cannot", "already", "turn ", "you are", "pick a", "sitting" }) do
            if m:find(w, 1, true) then return "warn" end
        end
        for _, w in ipairs({ "flung", "grabbed", " done" }) do
            if m:find(w, 1, true) then return "success" end
        end
        return "info"
    end

    local function ensureGui()
        if NOTIFY.gui and NOTIFY.gui.Parent then return true end
        local gui = Instance.new("ScreenGui")
        gui.Name = "MM2_Notify"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 2147483000
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        local parents = {
            function() return (typeof(gethui) == "function") and gethui() or nil end,
            function() return lp:FindFirstChildOfClass("PlayerGui") end,
            function() return game:GetService("CoreGui") end,
        }
        local mounted = false
        for _, getParent in ipairs(parents) do
            local ok = pcall(function() gui.Parent = getParent() end)
            if ok and gui.Parent then mounted = true break end
        end
        if not mounted then
            pcall(function() gui:Destroy() end)
            return false
        end
        local list = Instance.new("Frame")
        list.Name = "List"
        list.BackgroundTransparency = 1
        list.AnchorPoint = Vector2.new(1, 0)
        list.Position = UDim2.new(1, -12, 0, 56)
        list.Size = UDim2.fromOffset(WIDTH, 0)
        list.AutomaticSize = Enum.AutomaticSize.Y
        list.Parent = gui
        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 5)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        layout.Parent = list
        NOTIFY.gui, NOTIFY.list = gui, list
        return true
    end

    local function dismiss(holder)
        if not (holder and holder.Parent) or holder:GetAttribute("Closing") then return end
        holder:SetAttribute("Closing", true)
        pcall(function()
            local toast = holder:FindFirstChild("Toast")
            if toast then
                TweenService:Create(toast, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
                    { Position = UDim2.new(1, 40, 0, 0) }):Play()
            end
        end)
        task.delay(0.26, function()
            pcall(function()
                if not holder.Parent then return end
                holder.AutomaticSize = Enum.AutomaticSize.None
                holder.Size = UDim2.fromOffset(WIDTH, holder.AbsoluteSize.Y)
                local t = TweenService:Create(holder, TweenInfo.new(0.18, Enum.EasingStyle.Quad),
                    { Size = UDim2.fromOffset(WIDTH, 0) })
                t.Completed:Connect(function() pcall(function() holder:Destroy() end) end)
                t:Play()
            end)
        end)
    end

    local function label(parent, text, font, size, color, order)
        local l = Instance.new("TextLabel")
        l.BackgroundTransparency = 1
        l.Size = UDim2.new(1, 0, 0, 0)
        l.AutomaticSize = Enum.AutomaticSize.Y
        l.Font = font
        l.TextSize = size
        l.TextColor3 = color
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.TextYAlignment = Enum.TextYAlignment.Top
        l.TextWrapped = true
        l.Text = text
        l.LayoutOrder = order
        l.Parent = parent
        return l
    end

    notify = function(msg, kind, title)
        msg = tostring(msg)
        local now = os.clock()
        if NOTIFY.last[msg] and now - NOTIFY.last[msg] < 1.5 then return end   -- same text again: ignore
        NOTIFY.last[msg] = now
        pcall(function()
            if not alive or not ensureGui() then return end
            local k = KINDS[kind or guessKind(msg)] or KINDS.info
            local duration = math.clamp(1.8 + #msg * 0.03, 2.5, 5)

            -- keep at most MAX toasts on screen: the oldest one leaves
            local shown = {}
            for _, h in ipairs(NOTIFY.list:GetChildren()) do
                if h:IsA("Frame") and not h:GetAttribute("Closing") then shown[#shown + 1] = h end
            end
            table.sort(shown, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
            for i = 1, #shown - MAX + 1 do dismiss(shown[i]) end

            NOTIFY.order = NOTIFY.order + 1
            local holder = Instance.new("Frame")
            holder.Name = "Holder"
            holder.BackgroundTransparency = 1
            holder.Size = UDim2.fromOffset(WIDTH, 0)
            holder.AutomaticSize = Enum.AutomaticSize.Y
            holder.LayoutOrder = NOTIFY.order
            holder.Parent = NOTIFY.list

            local toast = Instance.new("Frame")
            toast.Name = "Toast"
            toast.Size = UDim2.new(1, 0, 0, 0)
            toast.AutomaticSize = Enum.AutomaticSize.Y
            toast.Position = UDim2.new(1, 40, 0, 0)   -- starts off to the right and slides in
            toast.BackgroundColor3 = Color3.fromRGB(22, 14, 34)
            toast.BackgroundTransparency = 0.05
            toast.BorderSizePixel = 0
            toast.Parent = holder
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 8)
            corner.Parent = toast
            local stroke = Instance.new("UIStroke")
            stroke.Color = k.color
            stroke.Transparency = 0.45
            stroke.Thickness = 1
            stroke.Parent = toast

            local accent = Instance.new("Frame")   -- colored strip on the left
            accent.Position = UDim2.new(0, 6, 0, 8)
            accent.Size = UDim2.new(0, 3, 1, -16)
            accent.BackgroundColor3 = k.color
            accent.BorderSizePixel = 0
            accent.Parent = toast
            local ac = Instance.new("UICorner")
            ac.CornerRadius = UDim.new(1, 0)
            ac.Parent = accent

            local content = Instance.new("Frame")
            content.BackgroundTransparency = 1
            content.Position = UDim2.new(0, 16, 0, 0)
            content.Size = UDim2.new(1, -24, 0, 0)
            content.AutomaticSize = Enum.AutomaticSize.Y
            content.Parent = toast
            local pad = Instance.new("UIPadding")
            pad.PaddingTop = UDim.new(0, 7)
            pad.PaddingBottom = UDim.new(0, 12)
            pad.Parent = content
            local lay = Instance.new("UIListLayout")
            lay.Padding = UDim.new(0, 2)
            lay.SortOrder = Enum.SortOrder.LayoutOrder
            lay.Parent = content
            label(content, string.upper(title or k.title), Enum.Font.GothamBold, 9, k.color, 1)
            label(content, msg, Enum.Font.GothamMedium, 11, Color3.fromRGB(240, 232, 250), 2)

            local track = Instance.new("Frame")   -- timer bar
            track.Position = UDim2.new(0, 16, 1, -5)
            track.Size = UDim2.new(1, -24, 0, 2)
            track.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            track.BackgroundTransparency = 0.9
            track.BorderSizePixel = 0
            track.Parent = toast
            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(1, 0, 1, 0)
            fill.BackgroundColor3 = k.color
            fill.BorderSizePixel = 0
            fill.Parent = track
            for _, f in ipairs({ track, fill }) do
                local c = Instance.new("UICorner")
                c.CornerRadius = UDim.new(1, 0)
                c.Parent = f
            end

            toast.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dismiss(holder)
                end
            end)

            TweenService:Create(toast, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                { Position = UDim2.new(0, 0, 0, 0) }):Play()
            TweenService:Create(fill, TweenInfo.new(duration, Enum.EasingStyle.Linear),
                { Size = UDim2.new(0, 0, 1, 0) }):Play()
            task.delay(duration, function() dismiss(holder) end)
        end)
    end
end

-- HTTP with fallback (some executors do not have game:HttpGet)
local function httpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" and #res > 0 then return res end
    local req = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
    if req then
        local ok2, r = pcall(req, { Url = url, Method = "GET" })
        if ok2 and type(r) == "table" and type(r.Body) == "string" and #r.Body > 0
            and (r.Success == true or r.StatusCode == 200) then
            return r.Body
        end
    end
    error("HttpGet failed: " .. tostring(res))
end

