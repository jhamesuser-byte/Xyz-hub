-- Player ESP (Highlight + label)
-- ------------------------------------------------------------
local marks = {}

local function clearMark(plr)
    local m = marks[plr]
    if m then
        pcall(function() m.hl:Destroy() end)
        pcall(function() m.bb:Destroy() end)
        marks[plr] = nil
    end
end

local function clearAll()
    for plr in pairs(marks) do clearMark(plr) end
end

local function ensureMark(plr, char)
    local m = marks[plr]
    if m and m.char == char and m.hl.Parent and m.bb.Parent then return m end
    clearMark(plr)
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not head then return nil end

    local hl = Instance.new("Highlight")
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 0.6
    hl.Adornee = char
    hl.Parent = workspace.CurrentCamera or workspace

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(170, 28)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = head
    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.fromScale(1, 1)
    tl.BackgroundTransparency = 1
    tl.Font = Enum.Font.GothamBold
    tl.TextSize = 14
    tl.TextStrokeTransparency = 0
    tl.Parent = bb
    bb.Parent = head

    m = { char = char, hl = hl, bb = bb, tl = tl }
    marks[plr] = m
    return m
end

-- Coin ESP (small dots; Highlight is limited to ~31 active)
local coinMarks = {}
local function clearCoinMarks()
    for p, bb in pairs(coinMarks) do
        pcall(function() bb:Destroy() end)
        coinMarks[p] = nil
    end
end

local function updateCoinEsp()
    if not S.coinEsp then
        if next(coinMarks) then clearCoinMarks() end
        return
    end
    local cont = coinContainer()
    if not cont then return end
    for _, c in ipairs(cont:GetDescendants()) do
        if c:IsA("BasePart") and c.Name == "Coin_Server" and not coinMarks[c] then
            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.fromOffset(8, 8)
            bb.AlwaysOnTop = true
            bb.Adornee = c
            local f = Instance.new("Frame")
            f.Size = UDim2.fromScale(1, 1)
            f.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
            f.BorderSizePixel = 0
            local cr = Instance.new("UICorner")
            cr.CornerRadius = UDim.new(1, 0)
            cr.Parent = f
            f.Parent = bb
            bb.Parent = c
            coinMarks[c] = bb
        end
    end
    for c, bb in pairs(coinMarks) do
        if not c.Parent then
            pcall(function() bb:Destroy() end)
            coinMarks[c] = nil
        end
    end
end

-- Dropped gun ESP
local gunHl
local function updateGunEsp()
    local drop = workspace:FindFirstChild("GunDrop")
    if S.gunEsp and drop and drop:IsA("PVInstance") then
        if not gunHl or not gunHl.Parent then
            gunHl = Instance.new("Highlight")
            gunHl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            gunHl.FillColor = Color3.fromRGB(255, 215, 0)
            gunHl.OutlineColor = Color3.fromRGB(255, 215, 0)
            gunHl.FillTransparency = 0.3
            gunHl.Parent = workspace.CurrentCamera or workspace
        end
        gunHl.Adornee = drop
    elseif gunHl then
        pcall(function() gunHl:Destroy() end)
        gunHl = nil
    end
end

-- Lighting
local fbOrig
local function applyLighting()
    if not S.fullbright then
        if fbOrig then
            for k, v in pairs(fbOrig) do
                pcall(function() Lighting[k] = v end)
            end
            fbOrig = nil
        end
        return
    end
    fbOrig = fbOrig or {
        Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
        GlobalShadows = Lighting.GlobalShadows, Ambient = Lighting.Ambient,
    }
    Lighting.Brightness = 2
    Lighting.ClockTime = 14
    Lighting.GlobalShadows = false
    Lighting.Ambient = Color3.new(1, 1, 1)
end

-- Status tab labels: the menu renderers register one setter per label id, refresh() fills them in
local INFO = {}
local function info(id, text)
    local set = INFO[id]
    if set then set(text) end
end
local activeFeatures   -- assigned once the menu spec exists
local menuKind = "loading"
local lastMurd, lastSher

local function describe(plr, myRoot)
    if not plr then return "?" end
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return plr.DisplayName .. " (dead)" end
    local r = char and char:FindFirstChild("HumanoidRootPart")
    if r and myRoot then
        return plr.DisplayName .. " (" .. math.floor((r.Position - myRoot.Position).Magnitude) .. "m)"
    end
    return plr.DisplayName
end

local function updateStatus(murd, sher, myRoot)
    local coins = 0
    local cont = coinContainer()
    if cont then
        for _, c in ipairs(cont:GetDescendants()) do
            if c:IsA("BasePart") and c.Name == "Coin_Server" then coins = coins + 1 end
        end
    end
    local alive, total = 0, 0
    for _, plr in ipairs(Players:GetPlayers()) do
        total = total + 1
        local h = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
        if h and h.Health > 0 then alive = alive + 1 end
    end
    local _, myHum = myParts()
    info("round", "Round: " .. ((murd or sher) and "active" or "waiting")
        .. "\nMurderer: " .. describe(murd, myRoot)
        .. "\nSheriff: " .. describe(sher, myRoot)
        .. "\nGun drop: " .. (workspace:FindFirstChild("GunDrop") and "on the map" or "none")
        .. "\nCoins on map: " .. coins)
    info("me", "Role: " .. roleOf(lp)
        .. "\nHealth: " .. (myHum and (math.floor(myHum.Health) .. "/" .. math.floor(myHum.MaxHealth)) or "?")
        .. "\nPlayers: " .. total .. " (" .. alive .. " alive)")
    info("aim", aimLine("Aimbot", AIM, S.aimbot) .. "\n" .. aimLine("Silent Aim", SILD, S.silent))
    info("script", "Active: " .. (activeFeatures and activeFeatures() or "?")
        .. "\n" .. EXEC .. "\nMenu: " .. menuKind)
end

local function refresh()
    local murd, sher
    local _, _, myRoot = myParts()
    for _, plr in ipairs(Players:GetPlayers()) do
        local role = roleOf(plr)
        ROLE[plr] = role
        if role == "Murderer" then murd = plr elseif role == "Sheriff" then sher = plr end

        if plr ~= lp then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if S.esp and char and hum and hum.Health > 0 then
                local m = ensureMark(plr, char)
                if m then
                    local col = COLORS[role]
                    m.hl.FillColor = col
                    m.hl.OutlineColor = col
                    m.tl.TextColor3 = col
                    local txt = plr.DisplayName .. " | " .. role
                    if S.dist and myRoot then
                        local r = char:FindFirstChild("HumanoidRootPart")
                        if r then txt = txt .. " | " .. math.floor((r.Position - myRoot.Position).Magnitude) .. "m" end
                    end
                    m.tl.Text = txt
                    m.bb.Enabled = S.labels
                end
            else
                clearMark(plr)
            end
        end
    end

    if S.notify then
