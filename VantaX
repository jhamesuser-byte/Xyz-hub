local PARTS = {
    Head = { "Head" },
    Torso  = { "UpperTorso", "Torso", "HumanoidRootPart" },
}

local function partOf(char, key)
    for _, n in ipairs(PARTS[key] or PARTS.Head) do
        local p = char:FindFirstChild(n)
        if p and p:IsA("BasePart") then return p end
    end
    return char:FindFirstChild("HumanoidRootPart")
end

-- set by "Shoot Murderer": forces the target role regardless of the Target setting
local FORCE = { role = nil }

local function wantRole(role, myRole)
    if FORCE.role then return role == FORCE.role end
    local a = S.target
    if a == "All" then return true end
    if a ~= "Auto" then return role == a end
    -- Auto: the murderer targets everyone; everyone else targets the murderer
    if myRole == "Murderer" then return true end
    return role == "Murderer"
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
pcall(function() rayParams.RespectCanCollide = true end)   -- non-collidable map parts must not count as walls

-- aim debug state, filled by pickTarget and shown in the Aim tab (AIM = aimbot, SILD = silent aim)
local AIM, SILD = {}, {}

-- A target is visible when nothing opaque sits between the camera and the part.
-- Nearly transparent parts (invisible walls) are skipped, up to 4 of them.
-- dot-call (workspace.Raycast(workspace, ...)) does not go through the __namecall hook
local function visible(cam, part, char)
    local ignore = { lp.Character, char, cam }
    local origin = cam.CFrame.Position
    local dir = part.Position - origin
    for _ = 1, 4 do
        rayParams.FilterDescendantsInstances = ignore
        local hit = workspace.Raycast(workspace, origin, dir, rayParams)
        if not hit then return true end
        local inst = hit.Instance
        if inst.Transparency < 0.9 then return false end
        ignore[#ignore + 1] = inst
    end
    return false
end

-- dbg (optional) receives how many players passed each filter, so the Aim tab can say why nothing is locked
local function pickTarget(fov, maxDist, partKey, wall, dbg)
    if dbg then dbg.cand, dbg.range, dbg.screen, dbg.fov, dbg.blocked, dbg.name = 0, 0, 0, 0, 0, nil end
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local _, myHum = myParts()
    if not myHum or myHum.Health <= 0 then return nil end
    local myRole = roleOf(lp)
    local center = cam.ViewportSize / 2
    local camPos = cam.CFrame.Position
    local bestPart, bestPlr
    local bestKey = math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if char and hum and hum.Health > 0 and wantRole(roleCached(plr), myRole) then
                if dbg then dbg.cand = dbg.cand + 1 end
                local part = partOf(char, partKey)
                if part then
                    local dist = (part.Position - camPos).Magnitude
                    if dist <= maxDist then
                        if dbg then dbg.range = dbg.range + 1 end
                        local sp, on = cam:WorldToViewportPoint(part.Position)
                        if on and sp.Z > 0 then
                            if dbg then dbg.screen = dbg.screen + 1 end
                            local dd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if dd <= fov then
                                if dbg then dbg.fov = dbg.fov + 1 end
                                local key = (S.prio == "Closest") and dist or dd
                                if key < bestKey then
                                    if (not wall) or visible(cam, part, char) then
                                        bestKey, bestPart, bestPlr = key, part, plr
                                    elseif dbg then
                                        dbg.blocked = dbg.blocked + 1
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if not bestPart then return nil end
    if dbg then dbg.name = bestPlr.DisplayName end
    return bestPart, bestPart.Position, bestPlr
end

-- one line of the Aim Debug label
local function aimLine(label, d, on)
    if not on then return label .. ": off" end
    if d.note then return label .. ": " .. d.note end
    if d.name then return label .. ": locked on " .. d.name end
    return string.format("%s: no target (matching Target %d, in range %d, on screen %d, in FOV %d, behind wall %d)",
        label, d.cand or 0, d.range or 0, d.screen or 0, d.fov or 0, d.blocked or 0)
end

-- ------------------------------------------------------------
-- Silent Aim (hooks) - state shared with the hooks via env.__MM2_SIL
-- ------------------------------------------------------------
-- mode is fixed to "All" (Raycast + Remote + Mouse); kept only so hooks left over from an older run keep working
local SIL = {
    lock = false, pos = Vector3.zero, part = nil, mode = "All", hit = 100,
    camPos = Vector3.zero, rootPos = Vector3.zero, mouse = nil,
    logOn = false, lastLog = 0,
}
pcall(function() SIL.mouse = lp:GetMouse() end)
env.__MM2_SIL = SIL

function SIL.near(origin)
    return (origin - SIL.camPos).Magnitude < 20 or (origin - SIL.rootPos).Magnitude < 20
end

function SIL.roll()
    return SIL.hit >= 100 or math.random(1, 100) <= SIL.hit
end

-- IMPORTANT: inside the hooks do not use colon calls (inst:Method()): that overwrites the pending
-- namecall name and the original method would run wrong. Property reads only.

-- true when the remote sits inside a Gun/Knife tool (looks up to 5 parents)
function SIL.isWeapon(remote)
    local p = remote
    for _ = 1, 5 do
        p = p and p.Parent
        if p and (p.Name == "Gun" or p.Name == "Knife") then return true end
    end
    return false
end

-- "Log Weapon Remotes": prints the weapon remote path, method and argument types (4 lines per second at most),
-- so the real remote and its argument layout can be read in the console (F9)
function SIL.logCall(remote, method, ...)
    local now = os.clock()
    if now - SIL.lastLog < 0.25 then return end
    SIL.lastLog = now
    local path, p = remote.Name, remote.Parent
    for _ = 1, 6 do
        if not p or p == game then break end
        path = p.Name .. "." .. path
        p = p.Parent
    end
    local args = table.pack(...)
    local kinds = {}
    for i = 1, args.n do kinds[i] = typeof(args[i]) end
    print("[MM2 Hub] " .. path .. " " .. method .. "(" .. table.concat(kinds, ", ") .. ")")
end

-- Weapon remote (Gun/Knife): swaps the aim Vector3/CFrame for the target (experimental heuristic)
function SIL.remote(remote, ...)
    if not SIL.isWeapon(remote) or not SIL.roll() then return nil end
    local args = table.pack(...)
    local changed = false
    for i = 1, args.n do
        local a = args[i]
        local t = typeof(a)
        if t == "Vector3" then
            args[i] = SIL.pos
            changed = true
        elseif t == "CFrame" then
            local ap = a.Position
            if (ap - SIL.rootPos).Magnitude > 15 then
                args[i] = CFrame.new(SIL.pos)
            else
                args[i] = CFrame.lookAt(ap, SIL.pos)
            end
            changed = true
        end
    end
    if changed then return args end
    return nil
end

local function ours()
    return typeof(checkcaller) == "function" and checkcaller()
end

-- The namecall hook uses its own flag (__MM2_NC2): hooks from an older version of this script stay installed
-- until you rejoin, but they only repeat the same redirect, so they do no harm.
local function installHooks()
    if typeof(hookmetamethod) ~= "function" or typeof(getnamecallmethod) ~= "function" then
        return false
    end
    local wrap = (typeof(newcclosure) == "function") and newcclosure or function(f) return f end

    if not env.__MM2_NC2 then
        env.__MM2_NC2 = true
        local old
        old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
            local m = getnamecallmethod()
            local st = env.__MM2_SIL
            if st and (st.lock or st.logOn) and not ours() then
                -- weapons may use a RemoteEvent (FireServer) or a RemoteFunction (InvokeServer)
                local remoteCall = (m == "FireServer" or m == "InvokeServer")
                if remoteCall and st.logOn and st.isWeapon(self) then
                    st.logCall(self, m, ...)
                    if typeof(setnamecallmethod) == "function" then setnamecallmethod(m) end
                end
                if st.lock then
                    if self == workspace then
                        if m == "Raycast" then
                            local origin, direction, params = ...
                            if typeof(origin) == "Vector3" and typeof(direction) == "Vector3"
                                and st.near(origin) and st.roll() then
                                local d = st.pos - origin
                                if d.Magnitude > 0.001 then
                                    return old(self, origin, d.Unit * direction.Magnitude, params)
                                end
                            end
                        elseif m == "FindPartOnRay" or m == "FindPartOnRayWithIgnoreList"
                            or m == "FindPartOnRayWithWhitelist" then
                            local ray = ...
                            if typeof(ray) == "Ray" and st.near(ray.Origin) and st.roll() then
                                local d = st.pos - ray.Origin
                                if d.Magnitude > 0.001 then
                                    return old(self, Ray.new(ray.Origin, d.Unit * ray.Direction.Magnitude), select(2, ...))
                                end
                            end
                        end
                    end
                    if remoteCall then
                        local packed = st.remote(self, ...)
                        if packed then
                            if typeof(setnamecallmethod) == "function" then setnamecallmethod(m) end
                            return old(self, table.unpack(packed, 1, packed.n))
                        end
                    end
                end
            end
            return old(self, ...)
        end))
    end

    if not env.__MM2_IX then
        env.__MM2_IX = true
        local oldIndex
        oldIndex = hookmetamethod(game, "__index", wrap(function(self, key)
            local st = env.__MM2_SIL
            if st and st.lock and st.mouse and self == st.mouse
                and (key == "Hit" or key == "Target") and not ours() then
                if st.roll() then
                    if key == "Hit" then return CFrame.new(st.pos) end
                    return st.part
                end
            end
            return oldIndex(self, key)
        end))
    end
    return true
end

local function computeSilent()
    SIL.lock = false
    SIL.hit = FORCE.role and 100 or S.silentHit
    SILD.note, SILD.name = nil, nil
    if not (S.silent or FORCE.role) then return end
    local cam = workspace.CurrentCamera
    local char, hum, root = myParts()
    if not cam or not char or not hum or hum.Health <= 0 then
        SILD.note = "no character"
        return
    end
    if not FORCE.role and S.aimNeedTool and not char:FindFirstChildOfClass("Tool") then
        SILD.note = "equip a weapon (Weapon Required is on)"
        return
    end
    SIL.camPos = cam.CFrame.Position
    SIL.rootPos = root and root.Position or SIL.camPos
    local part, pos
    if FORCE.role then
        part, pos = pickTarget(5000, 5000, "Torso", false)
    else
        part, pos = pickTarget(S.silentFov, S.maxDist, S.silentPart, S.wall, SILD)
    end
    if part then
        SIL.lock = true
        SIL.pos = pos
        SIL.part = part
    end
end

