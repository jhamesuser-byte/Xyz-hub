-- Status tab labels: the menu renderers register one setter per label id, refresh() fills them in
local INFO = {}
local function info(id, text)
    local set = INFO[id]
    if set then set(text) end
end
local scanLabels       -- assigned by the Slate renderer (finds the label TextLabels)
local activeFeatures   -- assigned once the menu spec exists
local menuKind = "loading"
local lastMurd, lastSher

local function describe(plr, myRoot)
    if not plr then return "?" end
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return plr.DisplayName .. " (dead)" end
    local r = char and char:FindFirstChild("HumanoidRootPart")
    if r and myRoot then
        return plr.DisplayName .. " (" .. math.floor((r.Position - myRoot.Position).Magnitude) .. "m)"
    end
    return plr.DisplayName
end

local function playerOfPart(part)
    local char = part and part.Parent
    return char and Players:GetPlayerFromCharacter(char) or nil
end

local coinCount, coinCountT = 0, 0
local function updateStatus(murd, sher, myRoot)
    if scanLabels then scanLabels() end

    -- counting coins walks the whole container: do it at most every 1.5 s
    if os.clock() - coinCountT > 1.5 then
        coinCountT = os.clock()
        coinCount = 0
        local cont = coinContainer()
        if cont then
            for _, c in ipairs(cont:GetDescendants()) do
                if c:IsA("BasePart") and c.Name == "Coin_Server" then coinCount = coinCount + 1 end
            end
        end
    end
    local nAlive, total = 0, 0
    for _, plr in ipairs(Players:GetPlayers()) do
        total = total + 1
        local h = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
        if h and h.Health > 0 then nAlive = nAlive + 1 end
    end
    local _, myHum = myParts()

    info("round", "Round: " .. ((murd or sher) and "active" or "waiting"))
    info("murd", "Murderer: " .. describe(murd, myRoot))
    info("sher", "Sheriff: " .. describe(sher, myRoot))
    local drop = findGunDrop()
    info("drop", "Gun drop: " .. (drop and ("on the map (" .. (drop.Parent and drop.Parent.Name or "?") .. ")") or "none"))
    info("coins", "Coins on map: " .. coinCount)

    info("role", "Role: " .. roleOf(lp))
    info("hp", "Health: " .. (myHum and (math.floor(myHum.Health) .. "/" .. math.floor(myHum.MaxHealth)) or "?"))
    info("players", "Players: " .. total .. " (" .. nAlive .. " alive)")

    local sp = SIL.lock and playerOfPart(SIL.part)
    info("silst", "Silent Aim: " .. (S.silent and (sp and ("locked on " .. sp.DisplayName) or "searching") or "off"))

    info("active", "Active: " .. (activeFeatures and activeFeatures() or "?"))
    info("exec", EXEC .. " | Menu: " .. menuKind)
end

local function refresh()
    local murd, sher
    local _, _, myRoot = myParts()
    for _, plr in ipairs(Players:GetPlayers()) do
        local role = roleOf(plr)
        ROLE[plr] = role
        if role == "Murderer" then murd = plr elseif role == "Sheriff" then sher = plr end

        if plr ~= lp then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if S.esp and char and hum and hum.Health > 0 then
                local m = ensureMark(plr, char)
                if m then
                    local col = COLORS[role]
                    m.hl.FillColor = col
                    m.hl.OutlineColor = col
                    m.tl.TextColor3 = col
                    local txt = plr.DisplayName .. " | " .. role
                    if S.dist and myRoot then
                        local r = char:FindFirstChild("HumanoidRootPart")
                        if r then txt = txt .. " | " .. math.floor((r.Position - myRoot.Position).Magnitude) .. "m" end
                    end
                    m.tl.Text = txt
                    m.bb.Enabled = S.labels
                end
            else
                clearMark(plr)
            end
        end
    end

    if S.notify then
        if murd and murd ~= lastMurd then notify("Murderer: " .. murd.DisplayName) end
        if sher and sher ~= lastSher then notify("Sheriff: " .. sher.DisplayName) end
    end
    lastMurd, lastSher = murd, sher

    updateStatus(murd, sher, myRoot)
    updateCoinEsp()
    updateGunEsp()
    applyLighting()
    if showSelected then showSelected() end
end

