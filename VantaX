-- camera: silent aim (target calculation) and its FOV circle
-- Bound AFTER Roblox's camera script (Camera priority + 1): a plain RenderStepped connection can run
-- before the camera update, which then overwrites the CFrame a forced shot just set.
-- Auto Shoot (sheriff): runs inside the render step, right after the Silent Aim target is computed, so the
-- shot leaves the very frame the murderer enters the FOV circle (same FOV, same target part and same
-- line-of-sight rule as Silent Aim). The gun is kept in hand while the option is on: no equip delay.
local function autoShootStep(now)
    if shooting then return end
    local char, hum = myParts()
    if not (char and hum and hum.Health > 0) or roleOf(lp) ~= "Sheriff" then
        if AUTO.active then endAutoShot() end
        return
    end

    local gun = char:FindFirstChild("Gun")
    if not (gun and gun:IsA("Tool")) then
        if AUTO.active then endAutoShot() end
        if now - AUTO.lastEquip > 0.4 then
            AUTO.lastEquip = now
            equip("Gun")
        end
        return
    end

    if not AUTO.active then
        if now < AUTO.nextShot then return end
        FORCE.role = "Murderer"   -- only the murderer counts, and roles are read fresh (not from the cache)
        local ok, part = pcall(pickTarget, S.silentFov, CFG.maxDist, S.silentPart, CFG.wall)
        if not (ok and part) then
            FORCE.role = nil
            return
        end
        local hooked = installHooks()
        FORCE.part = part
        if not hooked then FORCE.target = part end   -- no hooks: the camera has to do the aiming
        AUTO.active = true
        AUTO.fireAt = hooked and now or now + 0.15
        AUTO.endAt = now + (hooked and 0.35 or 0.6)
        AUTO.nextShot = now + 0.5
        if hooked then pcall(computeSilent) end   -- lock the target this very frame
    end

    if AUTO.fireAt and now >= AUTO.fireAt then
        AUTO.fireAt = nil
        pcall(function() gun:Activate() end)
    end
    if now >= AUTO.endAt then endAutoShot() end
end

local RS_NAME = "MM2Hub_Aim"
pcall(function() RunService:UnbindFromRenderStep(RS_NAME) end)
RunService:BindToRenderStep(RS_NAME, Enum.RenderPriority.Camera.Value + 1, function()
    local cam = workspace.CurrentCamera
    if not cam then return end

    -- Shoot Murderer: hold the camera on the murderer while the shot is being fired
    local ft = FORCE.target
    if FORCE.role and ft and ft.Parent then
        cam.CFrame = CFrame.lookAt(cam.CFrame.Position, ft.Position)
    end

    pcall(computeSilent)

    if S.autoShoot then
        pcall(autoShootStep, os.clock())
    elseif AUTO.active then
        endAutoShot()
    end

    circSil.Size = UDim2.fromOffset(S.silentFov * 2, S.silentFov * 2)
    circSil.Visible = (S.silent or S.autoShoot) and S.silentShowFov

end)

