    endAutoShot()
    pcall(function() RunService:UnbindFromRenderStep(RS_NAME) end)
    S.fullbright = false
    if curTween then pcall(function() curTween:Cancel() end) end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(flyOff)
    if wasNoclip then
        wasNoclip = false
        pcall(restoreCollision)
    end
    pcall(applyLighting)
