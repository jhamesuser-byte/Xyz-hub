-- ------------------------------------------------------------
-- Saved settings (needs readfile/writefile; skipped silently without them)
-- Valid ranges and choices come from the menu spec above, so a stale or hand-edited file cannot inject bad values.
-- ------------------------------------------------------------
local SETTINGS_FILE = "MM2Hub_settings.json"
local canFile = typeof(readfile) == "function" and typeof(writefile) == "function"
local NO_SAVE = { fly = true, noclip = true, coins = true, loopMurd = true, loopSher = true, flingPick = true }   -- these always start off

local RANGE, CHOICES = {}, {}
for _, t in ipairs(UI) do
    for _, sec in ipairs(t.sections) do
        for _, it in ipairs(sec.items) do
            if it[1] == "slider" then
                RANGE[it[3]] = { it[4], it[5] }
            elseif it[1] == "drop" then
                local set = {}
                for _, o in ipairs(it[4]) do set[o] = true end
                CHOICES[it[3]] = set
            end
        end
    end
end

local function loadSettings()
    if not canFile then return end
    local okR, raw = pcall(readfile, SETTINGS_FILE)
    if not okR or type(raw) ~= "string" then return end
    local okJ, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okJ or type(data) ~= "table" then return end
    for key, v in pairs(data) do
        local cur = S[key]
        if cur ~= nil and not NO_SAVE[key] and type(v) == type(cur) then
            if type(v) == "number" then
                local r = RANGE[key]
                if r and v == v then S[key] = math.clamp(math.floor(v + 0.5), r[1], r[2]) end
            elseif type(v) == "string" then
                if CHOICES[key] and CHOICES[key][v] then S[key] = v end
            else
                S[key] = v
            end
        end
    end
end

local saved = {}
local function currentSettings()
    local snap, changed = {}, false
    for key, v in pairs(S) do
        if not NO_SAVE[key] then
            snap[key] = v
            if saved[key] ~= v then changed = true end
        end
    end
    return snap, changed
end

local function saveSettings()
    if not canFile then return end
    local snap, changed = currentSettings()
    if not changed then return end
    local ok = pcall(function() writefile(SETTINGS_FILE, HttpService:JSONEncode(snap)) end)
    if ok then saved = snap end
end

