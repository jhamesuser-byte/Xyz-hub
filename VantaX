-- Slate labels: the label API is not documented, so the text is written straight into the label's
-- TextLabel (found by its placeholder text, which is unique per label); the Label methods are only a fallback.
local SLATE_LABELS = {}   -- id -> placeholder text
local LABEL_UI = {}       -- id -> TextLabel
local scanTries, lastScan = 0, 0

scanLabels = function()
    if scanTries >= 8 or os.clock() - lastScan < 1.5 then return end
    local wanted, missing = {}, 0
    for id, text in pairs(SLATE_LABELS) do
        local d = LABEL_UI[id]
        if not (d and d.Parent) then
            LABEL_UI[id] = nil
            wanted[text] = id
            missing = missing + 1
        end
    end
    if missing == 0 then return end
    lastScan = os.clock()
    scanTries = scanTries + 1
    local roots = {}
    pcall(function() if typeof(gethui) == "function" then roots[#roots + 1] = gethui() end end)
    pcall(function() roots[#roots + 1] = game:GetService("CoreGui") end)
    pcall(function() roots[#roots + 1] = lp:FindFirstChild("PlayerGui") end)
    for _, r in ipairs(roots) do
        local ok, list = pcall(function() return r:GetDescendants() end)
        if ok then
            for _, d in ipairs(list) do
                if d:IsA("TextLabel") or d:IsA("TextButton") then
                    local id = wanted[d.Text]
                    if id and not LABEL_UI[id] then LABEL_UI[id] = d end
                end
            end
        end
    end
end

local function slateLabelSetter(id, lbl)
    return function(text)
        local d = LABEL_UI[id]
        if d and d.Parent then
            if d.Text ~= text then pcall(function() d.Text = text end) end
            return
        end
        for _, m in ipairs({ "Set", "SetText", "SetName", "SetValue", "Update" }) do
            local ok = pcall(function()
                local f = lbl[m]
                if type(f) ~= "function" then error("no method") end
                f(lbl, text, true)
            end)
            if ok then return end
        end
    end
end

local function buildSlate()
    local okH, src = pcall(httpGet, SLATE_URL)
    if not okH then return nil, "downloading Slate: " .. tostring(src) end
    local fn, err = loadstring(src, "@Slate")
    if not fn then return nil, "compiling Slate: " .. tostring(err) end
    local okL, Slate = pcall(fn)
    if not okL or not Slate then return nil, "loading Slate: " .. tostring(Slate) end

    pcall(function() Slate:PreloadIcons({ "lucide" }) end)
    pcall(function() if Slate.Theme and Slate.Theme.Set then Slate.Theme:Set(THEME) end end)
    pcall(function() Slate.Theme.Preset("Violet") end)
    pcall(function() Slate:SetFontFamily("JosefinSans") end)

    local w, h, minW, minH = menuMetrics(S.menuScale)   -- the saved Menu Size
    local okW, win = pcall(function()
        return Slate:CreateWindow({
            Name = "MM2 Hub", Subtitle = "Murder Mystery 2", Icon = "crown", Logo = true,
            Size = UDim2.fromOffset(w, h), MinSize = Vector2.new(minW, minH),
            ToggleKey = Enum.KeyCode.RightShift,
        })
    end)
    if not okW or not win then return nil, "creating the window: " .. tostring(win) end
    MENU_WINDOW = win
    pcall(function() win:_clampToViewport() end)   -- a larger saved size must still fit on screen
    pcall(function() win:SetBackdrop("aurora") end)

    local created = 0
    for _, t in ipairs(UI) do
        -- a tab with an icon Slate does not know must not disappear: retry without the icon
        local okT, tab = pcall(function() return win:CreateTab({ Name = t.tab, Icon = t.icon }) end)
        if not (okT and tab) then
            okT, tab = pcall(function() return win:CreateTab({ Name = t.tab }) end)
        end
        if okT and tab then
            pcall(function() tab:SetColumns(2) end)
            for _, sec in ipairs(t.sections) do
                local okS, section = pcall(function() return tab:CreateSection({ Name = sec.name }) end)
                if okS and section then
                    for _, it in ipairs(sec.items) do
                        local kind = it[1]
                        local okI = pcall(function()
                            if kind == "toggle" then
                                local key, cb = it[3], it[4]
                                section:Toggle({
                                    Name = it[2], Default = S[key],
                                    Callback = function(v)
                                        S[key] = (v == true)
                                        if cb then pcall(cb, S[key]) end
                                    end,
                                })
                            elseif kind == "slider" then
                                local key, cb = it[3], it[7]
                                section:Slider({
                                    Name = it[2], Min = it[4], Max = it[5], Default = S[key],
                                    Callback = function(v)
                                        S[key] = math.floor((tonumber(v) or S[key]) + 0.5)
                                        if cb then pcall(cb, S[key]) end
                                    end,
                                })
                            elseif kind == "drop" then
                                local key, cb = it[3], it[5]
                                section:Dropdown({
                                    Name = it[2], Options = it[4], Default = S[key],
                                    Callback = function(v)
                                        S[key] = v
                                        if cb then pcall(cb, v) end
                                    end,
                                })
                            elseif kind == "players" then
                                local names = playerLabels()
                                PLAYER_DD = section:Dropdown({
                                    Name = it[2], Options = names, Default = names[1],
                                    Callback = function(v) pcall(it[3], v) end,
                                })
                            elseif kind == "button" then
                                local cb = it[3]
                                section:Button({ Name = it[2], Callback = function() pcall(cb) end })
                            elseif kind == "label" then
                                local lbl = section:Label({ Name = it[2] })
                                SLATE_LABELS[it[3]] = it[2]
                                INFO[it[3]] = slateLabelSetter(it[3], lbl)
                            end
                        end)
                        if okI then created = created + 1 end
                    end
                end
            end
        end
    end
    if created == 0 then
        pcall(function() win:Destroy() end)
        return nil, "Slate did not create any controls"
    end

    local shown = true
    pcall(function() win:SetVisible(true) end)
    return {
        toggle = function()
            shown = not shown
            pcall(function() win:SetVisible(shown) end)
        end,
        destroy = function() pcall(function() win:Destroy() end) end,
    }
end

