-- ------------------------------------------------------------
-- Fling
-- The character sits on the target and spins at a huge speed, so the physics contact throws him away.
-- It only works if players collide with each other in MM2 (NOT VERIFIED against the real game).
-- Each fling keeps going until the target is thrown away (or you press Stop Fling); Fling All gives up on
-- one player after FLING_BATCH_MAX seconds so it can move on to the next.
-- Fling mode: the first fling you start pauses Anti Fling (it would switch the players' collision off and
-- the fling needs it). It stays paused until you press Stop Fling and no Loop Fling toggle is on.
-- Noclip is also paused while a fling runs, then you are put back where you were.
-- ------------------------------------------------------------
local FLING_BATCH_MAX = 12

local function setFlingMode(on)
    if on and not FLING.active and S.antiFling then notify("Anti Fling paused while flinging") end
    FLING.active = on
end

local function liveParts(plr)
    local c = plr and plr.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if h and r and h.Health > 0 then return h, r end
    return nil
end

-- returns the reason why a fling cannot start now, or nil
local function flingBlocked()
    if FLING.busy then return "Already flinging" end
    if S.fly then return "Turn Fly off first" end
    if S.coins then return "Turn Auto Farm Coins off first" end
    local _, hum, root = myParts()
    if not (hum and root) or hum.Health <= 0 then return "You are dead" end
    return nil
end

-- Flings one player; returns true when he was thrown away (and, when it gave up, the reason).
-- quiet = no notifications, inBatch = the caller (Fling All) already owns FLING.busy.
-- Method: stand inside the target's body (above, below and beside it, spinning) with absurd velocities,
-- a body thrust and a heavy body, so the physics contact throws him; repeats until he leaves the map.
local function flingPlayer(plr, quiet, inBatch, homeCF)
    if not inBatch then
        local why = flingBlocked()
        if why then
            if not quiet then notify(why) end
            return false
        end
    end
    local char, hum, root = myParts()
    local thum, troot = liveParts(plr)
    if not (char and hum and root and thum and troot) then
        if not quiet then notify("That player is not available") end
        return false
    end
    local thead = plr.Character and plr.Character:FindFirstChild("Head")

    FLING.busy = true
    setFlingMode(true)
    if not inBatch then FLING.stop = false end
    local home = homeCF or root.CFrame   -- where you were when you started: you come back here when it ends
    local oldFall = workspace.FallenPartsDestroyHeight
    local cam = workspace.CurrentCamera
    local oldSubject = cam and cam.CameraSubject
    local oldProps = root.CustomPhysicalProperties
    pcall(function() workspace.FallenPartsDestroyHeight = 0 / 0 end)   -- do not get deleted when thrown down
    pcall(function()
        root.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
        if cam then cam.CameraSubject = thum end   -- the camera follows him instead of spinning with you
    end)
    local thrust = Instance.new("BodyThrust")
    thrust.Name = "MM2_Thrust"
    thrust.Force = Vector3.new(9999, 9999, 9999)
    thrust.Location = root.Position
    pcall(function() thrust.Parent = root end)

    local flung, reason = false, nil
    pcall(function()
        local t0 = os.clock()
        local limit = inBatch and FLING_BATCH_MAX or math.huge
        local angle = 0

        local function thrown()
            return troot.AssemblyLinearVelocity.Magnitude > 400 or troot.Position.Y < oldFall + 10
        end
        local function running()
            if not (alive and not FLING.stop and root.Parent and troot.Parent) then return false end
            if hum.Health <= 0 or thum.Health <= 0 then return false end
            if thum.Sit then reason = plr.DisplayName .. " is sitting" return false end
            return os.clock() - t0 < limit
        end
        -- one frame: put the body at an offset of the target part, spinning, then check the result
        local function hit(base, offset, rot)
            root.CFrame = CFrame.new(base.Position) * offset * rot
            root.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
            root.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)
            RunService.Heartbeat:Wait()
            if thrown() then flung = true end
            return flung or not running()
        end

        while running() and not flung do
            -- every 2 s change the body part he is hit on (root <-> head)
            local base = (thead and thead.Parent and math.floor((os.clock() - t0) / 2) % 2 == 1) and thead or troot
            local speed = base.AssemblyLinearVelocity.Magnitude
            local ahead = thum.MoveDirection * speed / 1.25
            if speed < 50 then   -- standing or slow: spin through him from every side
                angle = angle + 100
                local rot = CFrame.Angles(math.rad(angle), 0, 0)
                for _, off in ipairs({
                    CFrame.new(0, 1.5, 0) + ahead,
                    CFrame.new(0, -1.5, 0) + ahead,
                    CFrame.new(2.25, 1.5, -2.25) + ahead,
                    CFrame.new(-2.25, -1.5, 2.25) + ahead,
                    CFrame.new(0, 1.5, 0) + thum.MoveDirection,
                    CFrame.new(0, -1.5, 0) + thum.MoveDirection,
                }) do
                    if hit(base, off, rot) then break end
                end
            else                 -- moving fast: cut across his path
                local walk, v = thum.WalkSpeed, speed / 1.25
                local flat, up = CFrame.Angles(0, 0, 0), CFrame.Angles(math.rad(90), 0, 0)
                for _, s in ipairs({
                    { CFrame.new(0, 1.5, walk), up }, { CFrame.new(0, -1.5, -walk), flat },
                    { CFrame.new(0, 1.5, walk), up }, { CFrame.new(0, 1.5, v), up },
                    { CFrame.new(0, -1.5, -v), flat }, { CFrame.new(0, 1.5, v), up },
                    { CFrame.new(0, -1.5, 0), flat },
                }) do
                    if hit(base, s[1], s[2]) then break end
                end
            end
        end
    end)

    -- take the thrust off, stop all the spinning and go back to where the fling was started
    pcall(function() thrust:Destroy() end)
    pcall(function()
        local goal = home * CFrame.new(0, 0.5, 0)
        for i = 1, 90 do
            if not root.Parent then break end
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("BasePart") then
                    d.AssemblyLinearVelocity = Vector3.zero
                    d.AssemblyAngularVelocity = Vector3.zero
                end
            end
            char:PivotTo(goal)
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            RunService.Heartbeat:Wait()
            if i >= 10 and (root.Position - goal.Position).Magnitude < 3 then break end
        end
    end)
    pcall(function()
        workspace.FallenPartsDestroyHeight = oldFall
        root.CustomPhysicalProperties = oldProps
        if cam then cam.CameraSubject = oldSubject or hum end
    end)
    if not inBatch then FLING.busy = false end
    if reason and not quiet then notify(reason) end
    return flung, reason
end

local function findRolePlayer(roleName)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and roleOf(plr) == roleName and liveParts(plr) then return plr end
    end
    return nil
end

local function flingAndReport(plr)
    task.spawn(function()
        local ok = flingPlayer(plr)
        if ok then notify("Flung " .. plr.DisplayName .. " successfully", "success") end
    end)
end

local function flingRole(roleName)
    if roleOf(lp) == roleName then notify("You are the " .. roleName); return end
    local plr = findRolePlayer(roleName)
    if not plr then notify(roleName .. " not found"); return end
    flingAndReport(plr)
end

local function flingNearest()
    local _, _, root = myParts()
    if not root then return end
    local best, bd
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            local _, r = liveParts(plr)
            if r then
                local d = (r.Position - root.Position).Magnitude
                if not bd or d < bd then best, bd = plr, d end
            end
        end
    end
    if not best then notify("No player to fling"); return end
    flingAndReport(best)
end

local function flingAll()
    local why = flingBlocked()
    if why then notify(why); return end
    FLING.busy, FLING.stop = true, false
    setFlingMode(true)
    local _, _, myRoot = myParts()
    local startCF = myRoot and myRoot.CFrame   -- Fling All brings you back here after each player
    task.spawn(function()
        local count = 0
        pcall(function()
            for _, plr in ipairs(Players:GetPlayers()) do
                if FLING.stop or not alive then break end
                if plr ~= lp and liveParts(plr) then
                    if flingPlayer(plr, true, true, startCF) then count = count + 1 end
                end
            end
        end)
        FLING.busy = false
        notify("Fling All successful: " .. count .. " flung", "success")
    end)
end

-- player picker (the menu has no dynamic list, so it cycles through the players)
showSelected = function()
    local plr = FLING.sel
    if plr and not plr.Parent then FLING.sel, plr = nil, nil end
    info("flingsel", "Selected: " .. (plr and (plr.DisplayName .. " | " .. roleOf(plr)) or "none"))
end

-- player names for the picker: "DisplayName (@username)", or just the name when both are equal
local function playerLabel(plr)
    if plr.DisplayName ~= plr.Name then return plr.DisplayName .. " (@" .. plr.Name .. ")" end
    return plr.Name
end

local function playerLabels()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then list[#list + 1] = playerLabel(plr) end
    end
    table.sort(list, function(a, b) return a:lower() < b:lower() end)
    if #list == 0 then list[1] = "(no players)" end
    return list
end

local function playerByLabel(label)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and playerLabel(plr) == label then return plr end
    end
    return nil
end

local function pickPlayer(label)
    S.flingPick = label
    FLING.sel = playerByLabel(label)
    showSelected()
end

-- re-reads the player list into the dropdown. Slate's dropdown API is not documented, so a few common
-- method names are tried; if none of them exists the list stays as it was when the menu opened
-- (the Next / Previous Player buttons always use the live list).
local function refreshPlayerList()
    local names = playerLabels()
    if PLAYER_DD then
        for _, m in ipairs({ "Refresh", "SetOptions", "UpdateOptions", "SetValues", "SetList" }) do
            local fn = PLAYER_DD[m]
            if type(fn) == "function" and pcall(fn, PLAYER_DD, names) then break end
        end
    end
    if not (FLING.sel and FLING.sel.Parent) then
        S.flingPick = names[1]
        FLING.sel = playerByLabel(names[1])
    end
    showSelected()
    return playerByLabel(names[1]) and #names or 0
end

do   -- the first player of the list is selected from the start (it is what the dropdown shows)
    local first = playerLabels()[1]
    S.flingPick = first
    FLING.sel = playerByLabel(first)
end
track(Players.PlayerAdded:Connect(function() task.delay(0.5, refreshPlayerList) end))
track(Players.PlayerRemoving:Connect(function() task.delay(0.5, refreshPlayerList) end))

local function cycleSelected(step)
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then list[#list + 1] = plr end
    end
    table.sort(list, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
    if #list == 0 then
        FLING.sel = nil
        showSelected()
        return
    end
    local idx = 0
    for i, plr in ipairs(list) do
        if plr == FLING.sel then idx = i break end
    end
    if idx == 0 then idx = (step > 0) and 1 or #list else idx = ((idx - 1 + step) % #list) + 1 end
    FLING.sel = list[idx]
    S.flingPick = playerLabel(FLING.sel)
    showSelected()
end

local function flingSelected()
    if not (FLING.sel and FLING.sel.Parent) then
        notify("Select a player first")
        return
    end
    flingAndReport(FLING.sel)
end

-- ------------------------------------------------------------
-- Run animation (Player tab). Rewrites the AnimationId inside the character's own Animate script (run and walk
-- sets) and restarts that script, so the game plays the animation itself and everyone sees it. R15 only.
-- The preset ids are from memory and NOT verified on this build: every id is test-loaded before it is applied, and
-- the original ids are restored when it does not load. "Nearest Player" copies the run animation another player
-- is wearing right now, so it needs no id at all.
-- ------------------------------------------------------------
local RUN_PRESETS = {
    Ninja       = "rbxassetid://656118852",
    Cartoony    = "rbxassetid://742638842",
    Zombie      = "rbxassetid://616163682",
    Robot       = "rbxassetid://616091570",
    Levitation  = "rbxassetid://616010382",
    Stylish     = "rbxassetid://616140816",
    Superhero   = "rbxassetid://616117076",
    Toy         = "rbxassetid://782842708",
    Werewolf    = "rbxassetid://1083216690",
    Astronaut   = "rbxassetid://891636393",
    Bubbly      = "rbxassetid://910025107",
    Mage        = "rbxassetid://707861613",
    Elder       = "rbxassetid://845386501",
    Knight      = "rbxassetid://657564596",
    Pirate      = "rbxassetid://750783738",
}
local RUN_CHOICES = { "Off" }
do
    local names = {}
    for n in pairs(RUN_PRESETS) do names[#names + 1] = n end
    table.sort(names)
    for _, n in ipairs(names) do RUN_CHOICES[#RUN_CHOICES + 1] = n end
    RUN_CHOICES[#RUN_CHOICES + 1] = "Nearest Player"
end
local origAnimIds = setmetatable({}, { __mode = "k" })   -- Animation instance -> id it had before we changed it
local copiedRunId   -- last id taken from "Nearest Player", reused after a respawn

local function nearestPlayerRunId()
    local _, _, root = myParts()
    if not root then return nil end
    local bestId, bestDist
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr ~= lp and plr.Character
        local theirRoot = char and char:FindFirstChild("HumanoidRootPart")
        local animate = char and char:FindFirstChild("Animate")
        local run = animate and animate:FindFirstChild("run")
        local anim = run and run:FindFirstChildWhichIsA("Animation")
        if theirRoot and anim and anim.AnimationId ~= "" then
            local d = (theirRoot.Position - root.Position).Magnitude
            if not bestDist or d < bestDist then bestId, bestDist = anim.AnimationId, d end
        end
    end
    return bestId
end

local function runIdFor(choice, fresh)
    if choice == "Nearest Player" then
        if fresh or not copiedRunId then copiedRunId = nearestPlayerRunId() end
        return copiedRunId
    end
    return RUN_PRESETS[choice]
end

local function animationLoads(hum, id)
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return true end   -- nothing to test with
    local anim = Instance.new("Animation")
    anim.AnimationId = id
    local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
    local length = 0
    if ok and track then
        local t0 = os.clock()
        while track.Length == 0 and os.clock() - t0 < 2 do task.wait(0.05) end
        length = track.Length
        pcall(function() track:Destroy() end)
    end
    anim:Destroy()
    return length > 0
end

local function applyRunAnimation(quiet, fresh)
    local char, hum = myParts()
    if not (char and hum) or hum.Health <= 0 then
        if not quiet then notify("Your character is not ready") end
        return
    end
    local animate = char:FindFirstChild("Animate") or char:WaitForChild("Animate", 3)
    if not animate then
        if not quiet then notify("This game has no Animate script") end
        return
    end
    local anims = {}
    for _, setName in ipairs({ "run", "walk" }) do
        local folder = animate:FindFirstChild(setName)
        if folder then
            for _, a in ipairs(folder:GetChildren()) do
                if a:IsA("Animation") then anims[#anims + 1] = a end
            end
        end
    end
    if #anims == 0 then
        if not quiet then notify("No run animation found on this character") end
        return
    end

    local choice = S.runAnim
    local id
    if choice ~= "Off" then
        if hum.RigType ~= Enum.HumanoidRigType.R15 then
            if not quiet then notify("Run animations need an R15 character") end
            return
        end
        id = runIdFor(choice, fresh)
        if not id then
            notify(choice == "Nearest Player" and "No other player to copy from" or "No animation found")
            return
        end
        if not animationLoads(hum, id) then
            notify("Could not load that animation")
            id = nil
        end
    end

    animate.Disabled = true
    for _, a in ipairs(anims) do
        if not origAnimIds[a] then origAnimIds[a] = a.AnimationId end
        a.AnimationId = id or origAnimIds[a]
    end
    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
            local pr = tr.Priority
            if pr == Enum.AnimationPriority.Core or pr == Enum.AnimationPriority.Idle
                or pr == Enum.AnimationPriority.Movement then
                pcall(function() tr:Stop(0.1) end)
            end
        end
    end
    animate.Disabled = false
    if not quiet then
        notify(id and ("Run animation set: " .. choice) or "Run animation restored", id and "success" or "info")
    end
end

-- the new character after a respawn has a fresh Animate script: apply the chosen animation again
track(lp.CharacterAdded:Connect(function()
    if S.runAnim ~= "Off" then
        task.wait(0.6)
        pcall(applyRunAnimation, true)
    end
end))

