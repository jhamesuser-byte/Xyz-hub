-- camera: silent aim (target calculation), FOV circles, aimbot
-- Bound right after the default camera script (Camera priority + 1) so nothing overwrites the aim for that frame.
local AIM_BIND = "MM2HubAim"
local lastAimWarn = 0

local function aimStep(dt)
    local cam = workspace.CurrentCamera
    if not cam then return end

    SIL.logOn = S.logRemotes
    pcall(computeSilent)

    circAim.Size = UDim2.fromOffset(S.aimFov * 2, S.aimFov * 2)
    circAim.Visible = S.aimbot and S.aimShowFov
    circSil.Size = UDim2.fromOffset(S.silentFov * 2, S.silentFov * 2)
    circSil.Visible = S.silent and S.silentShowFov

    AIM.note = nil
    if not S.aimbot then return end
    local char, hum = myParts()
    if not (char and hum and hum.Health > 0) then
        AIM.note = "no character"
        return
    end
    if S.aimNeedTool and not char:FindFirstChildOfClass("Tool") then
        AIM.note = "equip a weapon (Weapon Required is on)"
        return
    end
    if S.aimHold and UIS.MouseEnabled and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        AIM.note = "waiting for right mouse button"
        return
    end

    local part, pos = pickTarget(S.aimFov, S.maxDist, S.aimPart, S.wall, AIM)
    if not part then return end
    local cp = cam.CFrame.Position
    local want = pos - cp
    if want.Magnitude < 0.001 then return end
    -- Aim Speed is the share of the remaining angle closed per frame at 60 fps; scaled by frame time so
    -- the feel does not change with the frame rate (100 = instant)
    local base = math.clamp(S.aimSpeed / 100, 0.02, 1)
    local a = 1 - (1 - base) ^ (math.max(dt, 0) * 60)
    local look = cam.CFrame.LookVector:Lerp(want.Unit, a)
    if look.Magnitude < 0.001 then return end
    cam.CFrame = CFrame.lookAt(cp, cp + look)
end

local function aimFrame(dt)
    local ok, err = pcall(aimStep, dt)
    if not ok and os.clock() - lastAimWarn > 5 then
        lastAimWarn = os.clock()
        warn("[MM2 Hub] aim: " .. tostring(err))
    end
end

if not pcall(function()
    RunService:BindToRenderStep(AIM_BIND, Enum.RenderPriority.Camera.Value + 1, aimFrame)
end) then
    track(RunService.RenderStepped:Connect(aimFrame))
end

-- combat: auto shoot (sheriff), kill aura (murderer)
local lastShot = 0
loop(0.12, function()
    local char, hum, root = myParts()
    if not (char and hum and hum.Health > 0 and root) then return end
    local myRole = roleOf(lp)

    -- Auto Shoot: as Sheriff, fire at the murderer whenever he is in range with a clear line of sight
    if S.autoShoot and myRole == "Sheriff" and not shooting and os.clock() - lastShot > CFG.shotCooldown then
        local cam = workspace.CurrentCamera
        local mchar = cam and findMurderer()
        local part = mchar and (mchar:FindFirstChild("UpperTorso") or mchar:FindFirstChild("Torso")
            or mchar:FindFirstChild("HumanoidRootPart"))
        if part and (part.Position - cam.CFrame.Position).Magnitude <= S.maxDist
            and visible(cam, part, mchar) then
            if shootMurderer(true) then lastShot = os.clock() end
        end
    end

    if S.aura and myRole == "Murderer" then
        local best, bd
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= lp then
                local c = plr.Character
                local h = c and c:FindFirstChildOfClass("Humanoid")
                local r = c and c:FindFirstChild("HumanoidRootPart")
                if h and r and h.Health > 0 then
                    local d = (r.Position - root.Position).Magnitude
                    if d <= S.auraRange and (not bd or d < bd) then
                        best, bd = r, d
                    end
                end
            end
        end
        if best then
            local knife = equip("Knife")
            if knife then
                root.CFrame = CFrame.lookAt(root.Position,
                    Vector3.new(best.Position.X, root.Position.Y, best.Position.Z))
                pcall(function() knife:Activate() end)
            end
        end
    end
end)

-- auto farm coins
-- Teleport: instant hop to each coin | Tween: smooth straight-line move at Tween Speed
-- Walk: the character walks to the coin with Humanoid:MoveTo at its normal WalkSpeed (no position writes)
loop(0.2, function()
    if not S.coins then return end
    local _, hum, root = myParts()
    if not (root and hum and hum.Health > 0) then return 0.5 end
    local coin, dist = nearestCoin(root)
    if not (coin and coin.Parent) then return 0.3 end
    coinTries[coin] = (coinTries[coin] or 0) + 1
    if S.coinMode == "Walk" then
        hum:MoveTo(coin.Position)
        local t0 = os.clock()
        local limit = dist / math.max(hum.WalkSpeed, 1) + 1.5
        while alive and S.coins and coin.Parent and root.Parent and hum.Health > 0
            and os.clock() - t0 < limit do
            local dx, dz = coin.Position.X - root.Position.X, coin.Position.Z - root.Position.Z
            if math.sqrt(dx * dx + dz * dz) < 3 then break end
            task.wait(0.1)
        end
        return S.coinDelay / 1000
    elseif S.coinMode == "Tween" then
        local goal = CFrame.new(coin.Position) * root.CFrame.Rotation
        curTween = TweenService:Create(root,
            TweenInfo.new(math.max(dist / S.coinSpeed, 0.05), Enum.EasingStyle.Linear),
            { CFrame = goal })
        curTween:Play()
        curTween.Completed:Wait()
        curTween = nil
    else
        root.CFrame = CFrame.new(coin.Position) * root.CFrame.Rotation
        root.AssemblyLinearVelocity = Vector3.zero
    end
    if touch and coin.Parent then
        pcall(touch, root, coin, 0)
        pcall(touch, root, coin, 1)
    end
    return S.coinDelay / 1000
end)

