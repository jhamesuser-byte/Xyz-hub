-- movement: speed, jump, fly
local fly = { bv = nil, bg = nil }
local function flyOff()
    if fly.bv then
        fly.bv:Destroy()
        fly.bv = nil
    end
    if fly.bg then
        fly.bg:Destroy()
        fly.bg = nil
    end
    local _, hum = myParts()
    if hum then hum.PlatformStand = false end
end

track(RunService.Heartbeat:Connect(function()
    local _, hum, root = myParts()
    if not hum or not root then return end
    if S.speed then hum.WalkSpeed = S.speedVal end
    if S.jump then
        hum.UseJumpPower = true
        hum.JumpPower = S.jumpVal
    end
    if S.fly then
        local cam = workspace.CurrentCamera
        if not cam then return end
        if not fly.bv or fly.bv.Parent ~= root then
            flyOff()
            fly.bv = Instance.new("BodyVelocity")
            fly.bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            fly.bv.Velocity = Vector3.zero
            fly.bv.Parent = root
            fly.bg = Instance.new("BodyGyro")
            fly.bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            fly.bg.P = 9e4
            fly.bg.Parent = root
        end
        hum.PlatformStand = true
        local lv = cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
        local dir = cam.CFrame.LookVector * (-lv.Z) + cam.CFrame.RightVector * lv.X
        fly.bv.Velocity = dir * S.flySpeed
        fly.bg.CFrame = cam.CFrame
    elseif fly.bv then
        flyOff()
    end
end))

-- noclip (also active during auto coins, to pass through walls)
local wasNoclip = false
local function restoreCollision()
    local char = lp.Character
    if not char then return end
    for _, n in ipairs({ "HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso" }) do
        local p = char:FindFirstChild(n)
        if p and p:IsA("BasePart") then p.CanCollide = true end
    end
end
track(RunService.Stepped:Connect(function()
    local active = S.noclip or S.coins
    local char = lp.Character
    if not char then return end
    if active then
        wasNoclip = true
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    elseif wasNoclip then
        wasNoclip = false
        restoreCollision()
    end
end))

