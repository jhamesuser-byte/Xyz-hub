-- Dropped gun lookup. The drop is not necessarily a direct child of the workspace (it can sit inside the
-- map model), so it is found with one scan at start plus DescendantAdded, instead of a root-level lookup.
local function insideCharacter(inst)
    local p = inst.Parent
    while p and p ~= workspace do
        if p:IsA("Model") and Players:GetPlayerFromCharacter(p) then return true end
        p = p.Parent
    end
    return false
end

local function isGunDrop(inst)
    if inst.Name == "GunDrop" then return true end
    return inst.Name == "Gun" and inst:IsA("Tool") and not insideCharacter(inst)   -- a gun Tool lying on the map
end

local gunDropCache
for _, d in ipairs(workspace:GetDescendants()) do
    if isGunDrop(d) then gunDropCache = d end
end
track(workspace.DescendantAdded:Connect(function(d)
    if isGunDrop(d) then gunDropCache = d end
end))

local function findGunDrop()
    if gunDropCache and gunDropCache.Parent and gunDropCache:IsDescendantOf(workspace) then return gunDropCache end
    gunDropCache = nil
    return nil
end

-- the part to touch / highlight for a drop (a Part, a Model, or a Tool with a Handle)
local function gunDropPart(drop)
    if not drop then return nil end
    if drop:IsA("BasePart") then return drop end
    return drop:FindFirstChildWhichIsA("BasePart", true)
end

-- names of gun-like objects on the map, shown when Grab Gun finds nothing (helps spotting a different name)
local function gunCandidates()
    local names, seen = {}, {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if d.Name:lower():find("gun") and not insideCharacter(d) then
            local label = d.Name .. " (" .. d.ClassName .. ")"
            if not seen[label] then
                seen[label] = true
                names[#names + 1] = label
                if #names >= 6 then break end
            end
        end
    end
    return names
end

-- Dropped gun ESP
local gunHl
local function updateGunEsp()
    local drop = findGunDrop()
    local target = drop and (drop:IsA("PVInstance") and drop or gunDropPart(drop))
    if S.gunEsp and target then
        if not gunHl or not gunHl.Parent then
            gunHl = Instance.new("Highlight")
            gunHl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            gunHl.FillColor = Color3.fromRGB(255, 215, 0)
