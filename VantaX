-- protection (defensive, local only)
-- Anti Fling: while on, every other player's body parts stop colliding with you, so you walk through them.
-- Turning it off, or entering fling mode (any fling started, until Stop Fling), gives their collision back.
local antiSaved = {}   -- part -> its original CanCollide
track(RunService.Stepped:Connect(function()
    if S.antiFling and not FLING.busy and not FLING.active then
        for _, plr in ipairs(Players:GetPlayers()) do
            local c = plr ~= lp and plr.Character
            if c then
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") and p.CanCollide then
                        antiSaved[p] = true
                        p.CanCollide = false
                    end
                end
            end
        end
    elseif next(antiSaved) then
        for p in pairs(antiSaved) do
            if p.Parent then p.CanCollide = true end
        end
        antiSaved = {}
    end
end))

-- Anti Void: remember the last normal position and snap back to it
local safeCF
track(RunService.Heartbeat:Connect(function()
    local _, hum, root = myParts()
    if not hum or not root or hum.Health <= 0 then
        safeCF = nil
        return
    end
    if FLING.busy then return end   -- our own fling: do not snap back
    local voided = S.antiVoid and root.Position.Y < workspace.FallenPartsDestroyHeight + CFG.voidMargin
    if voided then
        if safeCF then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = safeCF
        end
    else
        safeCF = root.CFrame
    end
end))

