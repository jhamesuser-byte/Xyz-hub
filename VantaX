-- MENU LITE (emergencia, sem Slate, sem Drawing): funciona em qualquer executor
-- ------------------------------------------------------------
local function buildLite()
    local lp = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local Lighting = game:GetService("Lighting")
    local S = { speed = false, jump = false, infjump = false, noclip = false, fly = false, esp = false, fullbright = false }
    local SPEED, JUMP, FLY = 50, 100, 60

    local function hum()
        local c = lp.Character
        return c and c:FindFirstChildOfClass("Humanoid")
    end
    local function root()
        local c = lp.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    -- fly
    local fly = { bv = nil, bg = nil }
    local function flyOff()
        if fly.bv then fly.bv:Destroy(); fly.bv = nil end
        if fly.bg then fly.bg:Destroy(); fly.bg = nil end
        local h = hum()
        if h then h.PlatformStand = false end
    end

    RunService.Heartbeat:Connect(function()
        local h, r = hum(), root()
        if not h or not r then return end
        if S.speed then h.WalkSpeed = SPEED end
        if S.jump then
            h.UseJumpPower = true
            h.JumpPower = JUMP
        end
        if S.fly then
            local cam = workspace.CurrentCamera
            if not cam then return end
            if not fly.bv or fly.bv.Parent ~= r then
                flyOff()
                fly.bv = Instance.new("BodyVelocity")
                fly.bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                fly.bv.Velocity = Vector3.zero
                fly.bv.Parent = r
                fly.bg = Instance.new("BodyGyro")
                fly.bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                fly.bg.P = 9e4
                fly.bg.Parent = r
            end
            h.PlatformStand = true
            local lv = cam.CFrame:VectorToObjectSpace(h.MoveDirection)
            local dir = cam.CFrame.LookVector * (-lv.Z) + cam.CFrame.RightVector * lv.X
            fly.bv.Velocity = dir * FLY
            fly.bg.CFrame = cam.CFrame
        end
    end)

    -- noclip
    RunService.Stepped:Connect(function()
        if not S.noclip then return end
        local c = lp.Character
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
    local function noclipOff()
        local c = lp.Character
        if not c then return end
        for _, n in ipairs({ "HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso" }) do
            local p = c:FindFirstChild(n)
            if p and p:IsA("BasePart") then p.CanCollide = true end
        end
    end

    -- pulo infinito
    UIS.JumpRequest:Connect(function()
        if S.infjump then
            local h = hum()
            if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)

    -- esp (Highlight)
    local hls = {}
    local function espFor(plr)
        if plr == lp then return end
        local c = plr.Character
        if not c then return end
        local h = hls[plr]
        if not h or not h.Parent then
            h = Instance.new("Highlight")
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.FillTransparency = 0.75
            h.FillColor = Color3.fromRGB(170, 70, 255)
            h.OutlineColor = Color3.fromRGB(170, 70, 255)
            h.Parent = workspace.CurrentCamera or workspace
            hls[plr] = h
        end
        h.Adornee = c
    end
    local function espAll()
        for _, p in ipairs(Players:GetPlayers()) do pcall(espFor, p) end
    end
    local function espOff()
        for p, h in pairs(hls) do
            pcall(function() h:Destroy() end)
            hls[p] = nil
        end
    end
    Players.PlayerRemoving:Connect(function(p)
        if hls[p] then
            pcall(function() hls[p]:Destroy() end)
            hls[p] = nil
        end
    end)
    task.spawn(function()
        while true do
            if S.esp then pcall(espAll) end
            task.wait(1)
        end
    end)

    -- fullbright
    local fbOrig
    local function fbOn()
        fbOrig = fbOrig or {
            Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
            GlobalShadows = Lighting.GlobalShadows, FogEnd = Lighting.FogEnd,
        }
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 1e6
    end
    local function fbOff()
        if fbOrig then
            for k, v in pairs(fbOrig) do Lighting[k] = v end
        end
    end

    -- interface
    local gui = Instance.new("ScreenGui")
    gui.Name = "VX_Lite"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 2147483645

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(190, 0)
    frame.AutomaticSize = Enum.AutomaticSize.Y
    frame.Position = UDim2.new(1, -200, 0.5, -170)
    frame.BackgroundColor3 = Color3.fromRGB(23, 16, 33)
    frame.BorderSizePixel = 0
    frame.Visible = false
    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(0, 10)
    fc.Parent = frame
    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 6)
    pad.PaddingBottom = UDim.new(0, 6)
    pad.PaddingLeft = UDim.new(0, 6)
    pad.PaddingRight = UDim.new(0, 6)
    pad.Parent = frame
    local list = Instance.new("UIListLayout")
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Padding = UDim.new(0, 4)
    list.Parent = frame

    local order = 0
    local function nextOrder()
        order = order + 1
        return order
    end

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 24)
    title.BackgroundTransparency = 1
    title.Text = "VANTAX LITE"
    title.TextColor3 = Color3.fromRGB(190, 140, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 15
    title.LayoutOrder = nextOrder()
    title.Parent = frame

    local function addToggle(label, key, onChange)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 34)
        b.TextColor3 = Color3.new(1, 1, 1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 14
        b.AutoButtonColor = true
        b.LayoutOrder = nextOrder()
        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(0, 8)
        bc.Parent = b
        local function refresh()
            b.Text = label .. ": " .. (S[key] and "ON" or "OFF")
            b.BackgroundColor3 = S[key] and Color3.fromRGB(110, 60, 190) or Color3.fromRGB(36, 24, 52)
        end
        refresh()
        b.Activated:Connect(function()
            S[key] = not S[key]
            pcall(onChange, S[key])
            refresh()
        end)
        b.Parent = frame
    end

    addToggle("Speed", "speed", function(v)
        if not v then
            local h = hum()
            if h then h.WalkSpeed = 16 end
        end
    end)
    addToggle("Jump", "jump", function(v)
        if not v then
            local h = hum()
            if h then h.JumpPower = 50 end
        end
    end)
    addToggle("Pulo infinito", "infjump", function() end)
    addToggle("Noclip", "noclip", function(v) if not v then noclipOff() end end)
    addToggle("Fly", "fly", function(v) if not v then flyOff() end end)
    addToggle("ESP", "esp", function(v)
        if v then espAll() else espOff() end
    end)
    addToggle("Fullbright", "fullbright", function(v)
        if v then fbOn() else fbOff() end
    end)

    mount(gui, true)
    frame.Parent = gui

    local api = {}
    function api.show(v) frame.Visible = v == true end
    function api.toggle() frame.Visible = not frame.Visible end
    return api
end

local lite
local function openLite()
    if not lite then
        local ok, res = pcall(buildLite)
        if ok then
            lite = res
        else
            say("ERRO no menu lite: " .. tostring(res):sub(1, 200))
        end
    end
    return lite
end

local function addDock(w)
    pcall(function()
        local g = Instance.new("ScreenGui")
        g.Name = "VX_Dock"
        g.ResetOnSpawn = false
        g.IgnoreGuiInset = true
        g.DisplayOrder = 2147483644
        local function btn(label, y, cb)
            local b = Instance.new("TextButton")
            b.Size = UDim2.fromOffset(44, 44)
            b.Position = UDim2.new(0, 6, 0.5, y)
            b.BackgroundColor3 = Color3.fromRGB(110, 60, 190)
            b.TextColor3 = Color3.new(1, 1, 1)
            b.Font = Enum.Font.GothamBold
            b.TextSize = 14
            b.Text = label
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0, 8)
            c.Parent = b
            b.Activated:Connect(function() pcall(cb) end)
            b.Parent = g
        end
