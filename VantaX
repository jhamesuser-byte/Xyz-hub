-- ------------------------------------------------------------
-- Fling
-- The character sits on the target and spins at a huge speed, so the physics contact throws him away.
-- It only works if players collide with each other in MM2 (NOT VERIFIED against the real game).
-- Our own protections (Anti Fling, Noclip, Anti Void) are paused while it runs, then you are put back
-- where you were.
-- ------------------------------------------------------------
local FLING_OFFSETS = {
    CFrame.new(0, 1.5, 0), CFrame.new(0, -1.5, 0),
    CFrame.new(2, 0, 0),   CFrame.new(-2, 0, 0),
    CFrame.new(0, 0, 2),   CFrame.new(0, 0, -2),
}

local function liveParts(plr)
    local c = plr and plr.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if h and r and h.Health > 0 then return h, r end
    return nil
end

-- returns the reason why a fling cannot start now, or nil
local function flingBlocked()
    if FLING.busy then return "Already flinging (press Stop Fling to cancel)" end
    if S.fly then return "Turn Fly off before flinging" end
    if S.coins then return "Turn Auto Farm Coins off before flinging" end
    local _, hum, root = myParts()
    if not (hum and root) or hum.Health <= 0 then return "You are dead" end
    return nil
end

-- Flings one player; returns true when he was thrown away. quiet = no notifications,
-- inBatch = the caller (Fling All) already owns FLING.busy.
local function flingPlayer(plr, quiet, inBatch)
    if not inBatch then
        local why = flingBlocked()
        if why then
            if not quiet then notify(why) end
            return false
        end
    end
    local _, hum, root = myParts()
    local thum, troot = liveParts(plr)
    if not (hum and root and thum and troot) then
        if not quiet then notify("That player is not available") end
        return false
    end

    FLING.busy = true
    if not inBatch then FLING.stop = false end
    local home = root.CFrame
    local startPos = troot.Position
    local oldFall = workspace.FallenPartsDestroyHeight
    pcall(function() workspace.FallenPartsDestroyHeight = -1e9 end)   -- do not get deleted when thrown down

    local flung = false
    pcall(function()
        local t0, n = os.clock(), 0
        while alive and not FLING.stop and os.clock() - t0 < S.flingTime do
            if not (root.Parent and troot.Parent and hum.Health > 0 and thum.Health > 0) then break end
            if (troot.Position - startPos).Magnitude > 150 or troot.AssemblyLinearVelocity.Magnitude > 450 then
                flung = true
                break
            end
            n = n + 1
            -- sit on him (a little ahead of where he is going) and spin
            root.CFrame = troot.CFrame * FLING_OFFSETS[n % #FLING_OFFSETS + 1] + troot.AssemblyLinearVelocity * 0.1
            root.AssemblyLinearVelocity = Vector3.new(5e7, 5e7, 5e7)
            root.AssemblyAngularVelocity = Vector3.new(5e7, 5e7, 5e7)
            RunService.Heartbeat:Wait()
        end
    end)

    -- go back and stop all the spinning
    pcall(function()
        for _ = 1, 12 do
            if not root.Parent then break end
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = home
            RunService.Heartbeat:Wait()
        end
    end)
    pcall(function() workspace.FallenPartsDestroyHeight = oldFall end)
    if not inBatch then FLING.busy = false end
    return flung
end

local function findRolePlayer(roleName)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and roleOf(plr) == roleName and liveParts(plr) then return plr end
    end
    return nil
end

local function flingAndReport(plr)
    task.spawn(function()
        local ok = flingPlayer(plr)
        if ok then notify("Flung " .. plr.DisplayName) end
    end)
end

local function flingRole(roleName)
    if roleOf(lp) == roleName then notify("You are the " .. roleName); return end
    local plr = findRolePlayer(roleName)
    if not plr then notify(roleName .. " not found"); return end
    flingAndReport(plr)
end

local function flingNearest()
    local _, _, root = myParts()
    if not root then return end
    local best, bd
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            local _, r = liveParts(plr)
            if r then
                local d = (r.Position - root.Position).Magnitude
                if not bd or d < bd then best, bd = plr, d end
            end
        end
    end
    if not best then notify("No player to fling"); return end
    flingAndReport(best)
end

local function flingAll()
    local why = flingBlocked()
    if why then notify(why); return end
    FLING.busy, FLING.stop = true, false
    task.spawn(function()
        local count = 0
        pcall(function()
            for _, plr in ipairs(Players:GetPlayers()) do
                if FLING.stop or not alive then break end
                if plr ~= lp and liveParts(plr) then
                    if flingPlayer(plr, true, true) then count = count + 1 end
                end
            end
        end)
        FLING.busy = false
        notify("Fling All done: " .. count .. " flung")
    end)
end

