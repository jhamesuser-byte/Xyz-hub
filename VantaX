local function mount(gui)
    local function try(getParent)
        local ok = pcall(function() gui.Parent = getParent() end)
        return ok and gui.Parent ~= nil
    end
    local order = {
        function() return lp:WaitForChild("PlayerGui", 5) end,
        function() return (typeof(gethui) == "function") and gethui() or nil end,
        function() return game:GetService("CoreGui") end,
    }
    for _, g in ipairs(order) do
        if try(g) then return true end
    end
    return false
end

