        lb.BackgroundTransparency = 1
        lb.TextColor3 = Color3.new(1, 1, 1)
        lb.Font = Enum.Font.GothamBold
        lb.TextSize = 12
        lb.TextXAlignment = Enum.TextXAlignment.Left
        lb.Parent = row
        local function paint() lb.Text = label .. ": " .. tostring(S[key]) end
        paint()
        local function bump(dir)
            S[key] = math.clamp(S[key] + dir * step, mn, mx)
            paint()
            if onChange then pcall(onChange, S[key]) end
        end
        local function mk(text, x, dir)
            local b = Instance.new("TextButton")
            b.Size = UDim2.fromOffset(28, 24)
            b.Position = UDim2.new(1, x, 0.5, -12)
            b.BackgroundColor3 = PURPLE
            b.TextColor3 = Color3.new(1, 1, 1)
            b.Font = Enum.Font.GothamBold
            b.TextSize = 16
            b.Text = text
            roundify(b, 6)
            b.Activated:Connect(function() bump(dir) end)
            b.Parent = row
        end
        mk("-", -62, -1)
        mk("+", -32, 1)
    end

    -- roles (text updated by refresh())
    local info = Instance.new("TextLabel")
    info.Size = UDim2.new(1, 0, 0, 48)
    info.BackgroundTransparency = 1
    info.Text = "Murderer: ?\nSheriff: ?\nYour role: ?"
    info.TextColor3 = Color3.new(1, 1, 1)
    info.Font = Enum.Font.Gotham
    info.TextSize = 12
    info.TextXAlignment = Enum.TextXAlignment.Left
    info.TextYAlignment = Enum.TextYAlignment.Top
    info.LayoutOrder = 0
    info.Parent = pages[UI[1].tab].frame
    setInfo = function(text) info.Text = text end

    for _, t in ipairs(UI) do
        local p = pages[t.tab]
        for _, sec in ipairs(t.sections) do
            addLabel(p, sec.name)
            for _, it in ipairs(sec.items) do
                local kind = it[1]
                if kind == "toggle" then addToggle(p, it[2], it[3], it[4])
                elseif kind == "drop" then addCycle(p, it[2], it[3], it[4], it[5])
                elseif kind == "slider" then addStepper(p, it[2], it[3], it[4], it[5], it[6] or 1, it[7])
                elseif kind == "button" then addButton(p, it[2], it[3]) end
            end
        end
    end

    showPage(UI[1].tab)
    mount(gui)
    win.Parent = gui
    return {
        toggle = function() win.Visible = not win.Visible end,
        destroy = function()
            setInfo = nil
            pcall(function() gui:Destroy() end)
        end,
    }
end

