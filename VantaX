local curTween
-- Coins already visited: a visited coin is never visited again. A collected coin can stay in the container, so
-- without this the farm kept going back to the coin it had just collected (it is the nearest one: distance 0).
local coinTries = setmetatable({}, { __mode = "k" })
-- A free coin carries a TouchInterest, which the server removes once the coin is collected. After any coin has
-- been seen with one, a coin without one counts as already collected (taken by another player or by us).
-- This comes from memory of the game, not from a measurement here: if no coin ever shows a TouchInterest, only
-- the visited-once rule applies.
local coinSignal = false
local function hasTouch(c)
    return c:FindFirstChild("TouchInterest") ~= nil or c:FindFirstChildOfClass("TouchTransmitter") ~= nil
end

local function nearestCoin(root)
    local container = coinContainer()
    if not container then return nil, math.huge end
    local coins = container:GetDescendants()
    if not coinSignal then
        for _, c in ipairs(coins) do
            if c:IsA("BasePart") and c.Name == "Coin_Server" and hasTouch(c) then
                coinSignal = true
                break
            end
        end
    end
    local best, bd = nil, math.huge
    for _, c in ipairs(coins) do
        if c:IsA("BasePart") and c.Name == "Coin_Server" and not coinTries[c]
            and (not coinSignal or hasTouch(c)) then
            local d = (c.Position - root.Position).Magnitude
            if d < bd then best, bd = c, d end
        end
    end
    return best, bd
end

local function tpToRole(roleName)
    local _, _, root = myParts()
    if not root then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and roleOf(plr) == roleName then
            local c = plr.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if r then
                root.CFrame = r.CFrame * CFrame.new(0, 0, 3)
                return
            end
        end
    end
    notify(roleName .. " not found")
end

-- Grab the dropped gun. "Touch" = fires the touch from where you stand (no teleport).
-- "Teleport" = quick hop to the gun and straight back.
local grabbing = false
-- Grab Gun, instant: 1) fire a touch on the drop from where you stand (no movement); 2) if the gun is still
-- not yours after a moment, hop onto it, wait for the pickup and go straight back to where you were.
local lastGrabFail = 0

local function grabGun(manual)
    if grabbing then return false end
    if not manual and os.clock() - lastGrabFail < 1.5 then return false end
    local _, hum, root = myParts()
    if not root or not hum or hum.Health <= 0 then return false end
    if hasTool(lp, "Gun") or hasTool(lp, "Knife") then
        if manual then notify("You already have a weapon") end
        return false
    end
    local part = gunDropPart(findGunDrop())
    if not part then
        if manual then
            local c = gunCandidates()
            notify("No dropped gun on the map")
        end
        return false
    end
    grabbing = true
    local function got() return hasTool(lp, "Gun") end
    -- still the same living character: re-read every step, because dying (or respawning) mid-grab must stop the teleport
    local function living()
        local _, h, r = myParts()
        return alive and h == hum and r == root and h.Health > 0 and r.Parent ~= nil
    end
    local back
    pcall(function()
        if touch and living() then
            pcall(touch, root, part, 0)
            pcall(touch, root, part, 1)
            local t0 = os.clock()
            while living() and not got() and part.Parent and os.clock() - t0 < 0.25 do task.wait(0.03) end
        end
        if living() and not got() and part.Parent then
            back = root.CFrame
            root.CFrame = part.CFrame
            local t0 = os.clock()
            while living() and not got() and part.Parent and os.clock() - t0 < 1 do
                if touch then
                    pcall(touch, root, part, 0)
                    pcall(touch, root, part, 1)
                end
                task.wait(0.05)
            end
        end
    end)
    if back and living() then   -- return only while still alive; a dead or respawned character is left alone
        root.CFrame = back
        root.AssemblyLinearVelocity = Vector3.zero
    end
    grabbing = false
    local ok = got()
    if ok then
        notify("Gun grabbed successfully", "success")
    else
        lastGrabFail = os.clock()
        if manual then notify("Could not grab the gun") end
    end
    return ok
end

local function findMurderer()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and roleOf(plr) == "Murderer" then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if char and hum and hum.Health > 0 then return char end
        end
    end
    return nil
end

-- Sheriff only: equips the gun, aims at the murderer and fires one shot (the Silent Aim hooks
-- are forced onto the murderer for the duration of the shot, whatever the Silent Aim toggle says).
-- Returns true when a shot was started. auto = called by Auto Shoot, so no notifications.
local shooting = false
local warnedNoHooks = false
local fireGun   -- defined below (needs learnedArgs)
local function shootMurderer(auto)
    if shooting or AUTO.active then return false end
    local function fail(msg)
        if not auto then notify(msg) end
        return false
    end
    if roleOf(lp) ~= "Sheriff" then return fail("You are not the Sheriff") end
    local mchar = findMurderer()
    if not mchar then return fail("Murderer not found") end
    local hooked = installHooks()
    if not hooked and (not auto or not warnedNoHooks) then
        warnedNoHooks = true
        notify("Hooks are not supported, aiming with the camera only")
    end
    local char0 = lp.Character
    local wasHeld = char0 ~= nil and char0:FindFirstChild("Gun") ~= nil
    local gun = equip("Gun")
    if not gun then return fail("Gun not found") end
    shooting = true
    task.spawn(function()
        FORCE.role = "Murderer"
        pcall(function()
            if not wasHeld then task.wait(0.3) end   -- let the equip finish before activating
            local t0, fired = os.clock(), false
            while alive and os.clock() - t0 < 1.5 do
                local part = mchar:FindFirstChild("UpperTorso") or mchar:FindFirstChild("Torso") or mchar:FindFirstChild("HumanoidRootPart")
                if not part or not part.Parent then break end
                if not hooked then FORCE.target = part end   -- only without hooks does the camera have to do the aiming
                local ready
                if hooked then
                    ready = SIL.lock
                else
                    ready = os.clock() - t0 > 0.15   -- no hooks: give the camera a moment to settle
                end
                if ready and not fired then
                    fired = true
                    fireGun(gun, part)
                    if not auto then notify("Shot fired successfully", "success") end
                    task.wait(0.35)
                    break
                end
                task.wait(0.03)
            end
        end)
        FORCE.role = nil
        FORCE.target = nil
        shooting = false
    end)
    return true
end

-- Murderer only: equips the knife and throws it at the closest player in line of sight.
-- How the throw is sent:
--   1. Learned call: when the executor supports hooks, the script records the game's own knife throw (remote
--      and arguments) the first time you throw by hand, and replays it with the target position swapped in.
--   2. Guess: a RemoteEvent named like "Throw" inside the Knife, fired with (origin CFrame, target CFrame).
--      NOT VERIFIED against the real game.
-- Every attempt ends with a notification that names the remote used and whether it was learned or guessed.
local throwing = false

-- Guess for the throw remote: exact "Throw", then "KnifeThrown" / "ThrowKnife", then any remote whose name
-- contains "throw". Looked up inside the knife first, then in ReplicatedStorage.
local function findThrowRemote(knife)
    local function search(root)
        local best, bestRank
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                local n = d.Name:lower()
                local rank
                if d.Name == "Throw" then
                    rank = 1
                elseif n == "knifethrown" or n == "throwknife" then
                    rank = 2
                elseif n:find("throw", 1, true) then
                    rank = 3
                end
                if rank and (not bestRank or rank < bestRank) then best, bestRank = d, rank end
            end
        end
        return best
    end
    return search(knife) or search(game:GetService("ReplicatedStorage"))
end

-- Arguments of a recorded call (seen = {remote, method, args...}) with the target swapped in. Positions are
-- replaced; every other value (strings, numbers, booleans) is replayed as recorded.
local function learnedArgs(seen, origin, tpos)
    local out = table.pack(table.unpack(seen, 3, seen.n))
    local nCF = 0
    for i = 1, out.n do
        if typeof(out[i]) == "CFrame" then nCF = nCF + 1 end
    end
    local k = 0
    for i = 1, out.n do
        local a = out[i]
        local t = typeof(a)
        if t == "Vector3" then
            out[i] = tpos
        elseif t == "CFrame" then
            k = k + 1
            -- 2+ CFrames: the last one is the target; a single CFrame: far from the thrower = target
            local isTarget = (nCF >= 2 and k == nCF) or (nCF == 1 and (a.Position - origin).Magnitude > 15)
            if isTarget then
                out[i] = CFrame.new(tpos)
            else
                out[i] = CFrame.lookAt(origin, tpos)
            end
        end
    end
    return out
end

-- Fires the gun at a part. If the game's own shot call was recorded (shoot once by hand), it is replayed with
-- the part's position swapped in; otherwise the tool is activated and the Silent Aim hooks do the aiming.
local gunHowNotified = {}
local function gunHow(how, detail)
    if gunHowNotified[how] then return end
    gunHowNotified[how] = true
    if how == "activate" then notify("Auto Shoot may not register the shot") end
end

-- Sends the gun's shot to the server. Order: 1) the game's own shot call, recorded the last time you fired by
-- hand (learned: exact arguments, positions swapped for the target); 2) the RemoteEvent "Shoot" inside the Gun
-- (seen in the remote list of this build) with guessed arguments (origin CFrame, target CFrame) - NOT VERIFIED;
-- 3) Tool:Activate, which only works when the gun's own script listens to Tool.Activated.
-- Returns true when a remote was fired.
local function sendShot(remote, args)
    if remote.ClassName == "RemoteFunction" then
        task.spawn(function() pcall(function() remote:InvokeServer(table.unpack(args, 1, args.n)) end) end)
    else
        pcall(function() remote:FireServer(table.unpack(args, 1, args.n)) end)
    end
end

fireGun = function(gun, part)
    local _, _, root = myParts()
    local origin = root and root.Position or Vector3.zero
    if part and part.Parent then
        local seen = SIL.gunSeen
        if seen and seen.path then
            local remote = gun
            for _, name in ipairs(seen.path) do
                remote = remote and remote:FindFirstChild(name)
            end
            if remote and (remote.ClassName == "RemoteEvent" or remote.ClassName == "RemoteFunction") then
                SIL.replaying = true
                sendShot(remote, learnedArgs(seen, origin, part.Position))
                SIL.replaying = false
                gunHow("learned", "firing the recorded shot call (" .. remote.Name .. ")")
                return true
            end
        end
        local shoot = gun:FindFirstChild("Shoot")
        if shoot and (shoot.ClassName == "RemoteEvent" or shoot.ClassName == "RemoteFunction") then
            SIL.replaying = true
            sendShot(shoot, table.pack(CFrame.lookAt(origin, part.Position), CFrame.new(part.Position)))
            SIL.replaying = false
            gunHow("guessed", "firing Gun.Shoot with default arguments (origin CFrame, target CFrame; not verified on this build)")
            return true
        end
    end
    pcall(function() gun:Activate() end)
    gunHow("activate", "no shot remote found, falling back to Tool:Activate")
    return false
end

local function throwKnife()
    if throwing then return false end
    if roleOf(lp) ~= "Murderer" then
        notify("You are not the Murderer")
        return false
    end
    local char, hum, root = myParts()
    if not (char and hum and root and hum.Health > 0) then
        notify("Your character is not ready")
        return false
    end
    if installHooks() then SIL.learnThrow = true end   -- from now on the game's own knife throw is recorded

    -- closest player in line of sight (forced: no FOV or on-screen limit)
    FORCE.role = "Any"
    local ok, part, _, plr = pcall(pickTarget, math.huge, CFG.maxDist, "Torso", true)
    local behindWall
    if ok and not part then
        local ok2, p2 = pcall(pickTarget, math.huge, CFG.maxDist, "Torso", false)
        behindWall = ok2 and p2 ~= nil
    end
    FORCE.role = nil
    if not (ok and part) then
        notify(behindWall and "No player in sight" or "No player in range")
        return false
    end

    local knife = equip("Knife")
    if not knife then
        notify("Knife not found")
        return false
    end
    throwing = true
    task.spawn(function()
        local ok3, err = pcall(function()
            local wasEquipped = knife.Parent == lp.Character
            local t0 = os.clock()
            while alive and knife.Parent ~= lp.Character and os.clock() - t0 < 0.8 do task.wait(0.03) end
            if knife.Parent ~= lp.Character then
                notify("Could not equip the knife")
                return
            end
            if not wasEquipped then task.wait(0.15) end   -- let the knife's own script finish its setup
            if not part.Parent then
                notify("The target is gone")
                return
            end

            local handle = knife:FindFirstChild("Handle")
            local origin = (handle and handle:IsA("BasePart")) and handle.Position or root.Position
            local tpos = part.Position

            local remote, method, args, how
            local seen = SIL.throwSeen
            if seen then
                -- the knife is a new instance every round: find the recorded remote again by name
                remote = knife:FindFirstChild(seen[1].Name, true)
                if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
                    method, args, how = seen[2], learnedArgs(seen, origin, tpos), "learned"
                else
                    remote = nil
                end
            end
            if not remote then
                remote = findThrowRemote(knife)
                if remote then
                    method = remote:IsA("RemoteFunction") and "InvokeServer" or "FireServer"
                    args = table.pack(CFrame.lookAt(origin, tpos), CFrame.new(tpos))
                    how = "guessed"
                end
            end
            if not remote then
                local names = {}
                for _, d in ipairs(knife:GetDescendants()) do
                    if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then names[#names + 1] = d.Name end
                end
                notify("Could not find the knife throw. Throw once by hand and try again")
                return
            end

            if method == "InvokeServer" and remote:IsA("RemoteFunction") then
                task.spawn(function()   -- InvokeServer yields until the server answers
                    pcall(function() remote:InvokeServer(table.unpack(args, 1, args.n)) end)
                end)
            else
                remote:FireServer(table.unpack(args, 1, args.n))
            end
            notify("Throw Knife successful", "success")
        end)
        if not ok3 then notify("Throw Knife failed") end
        throwing = false
    end)
    return true
end

local function serverHop()
    pcall(flushSettings)
    task.spawn(function()
        local ok, body = pcall(httpGet, "https://games.roblox.com/v1/games/" .. game.PlaceId
            .. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true")
        if not ok then
            notify("Could not load the server list")
            return
        end
        local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok2 or not data or not data.data then
            notify("Could not read the server list")
            return
        end
        local list = {}
        for _, s in ipairs(data.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then list[#list + 1] = s end
        end
        if #list == 0 then
            notify("No open servers found")
            return
        end
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, list[math.random(1, #list)].id, lp)
        end)
    end)
end

local function rejoin()
    pcall(flushSettings)
    pcall(function()
        if #Players:GetPlayers() <= 1 then
            TeleportService:Teleport(game.PlaceId, lp)
        else
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, lp)
        end
    end)
