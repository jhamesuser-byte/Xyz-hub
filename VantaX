-- ------------------------------------------------------------
-- GUI: monta um ScreenGui no melhor lugar disponivel
-- ------------------------------------------------------------
local function mount(gui, playerGuiFirst)
    local function try(getParent)
        local ok = pcall(function() gui.Parent = getParent() end)
        return ok and gui.Parent ~= nil
    end
    local function viaPlayerGui() return Players.LocalPlayer:WaitForChild("PlayerGui", 5) end
    local function viaGethui() return has("gethui") and gethui() or nil end
    local function viaCoreGui() return game:GetService("CoreGui") end
    local order
    if playerGuiFirst then
        order = { viaPlayerGui, viaGethui, viaCoreGui }
    else
        order = { viaGethui, viaCoreGui, viaPlayerGui }
    end
    for _, g in ipairs(order) do
        if try(g) then return true end
    end
    return false
end

