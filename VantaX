        local function paint() lb.Text = label .. ": " .. tostring(S[key]) end
        paint()
        local function bump(dir)
            S[key] = math.clamp(S[key] + dir * step, mn, mx)
            paint()
            if onChange then pcall(onChange, S[key]) end
        end
        local function mk(text, x, dir)
            local b = Instance.new("TextButton")
            b.Size = UDim2.fromOffset(28, 24)
            b.Position = UDim2.new(1, x, 0.5, -12)
            b.BackgroundColor3 = PURPLE
            b.TextColor3 = Color3.new(1, 1, 1)
            b.Font = Enum.Font.GothamBold
            b.TextSize = 16
            b.Text = text
            roundify(b, 6)
            b.Activated:Connect(function() bump(dir) end)
            b.Parent = row
        end
        mk("-", -62, -1)
        mk("+", -32, 1)
    end

    local function addInfo(p, text, id)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, 0, 0, 0)
        l.AutomaticSize = Enum.AutomaticSize.Y
        l.BackgroundTransparency = 1
        l.Text = text
        l.TextColor3 = Color3.new(1, 1, 1)
        l.Font = Enum.Font.Gotham
        l.TextSize = 12
        l.TextWrapped = true
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.TextYAlignment = Enum.TextYAlignment.Top
        l.LayoutOrder = slot(p)
        l.Parent = p.frame
        INFO[id] = function(t) l.Text = t end
    end

    for _, t in ipairs(UI) do
        local p = pages[t.tab]
        for _, sec in ipairs(t.sections) do
            addLabel(p, sec.name)
            for _, it in ipairs(sec.items) do
                local kind = it[1]
                if kind == "toggle" then addToggle(p, it[2], it[3], it[4])
                elseif kind == "drop" then addCycle(p, it[2], it[3], it[4], it[5])
                elseif kind == "players" then addCycle(p, it[2], "flingPick", playerLabels(), it[3])
                elseif kind == "slider" then addStepper(p, it[2], it[3], it[4], it[5], it[6] or 1, it[7])
                elseif kind == "button" then addButton(p, it[2], it[3])
                elseif kind == "label" then addInfo(p, it[2], it[3]) end
            end
        end
    end

    showPage(UI[1].tab)
    mount(gui)
    win.Parent = gui
    return {
        toggle = function() win.Visible = not win.Visible end,
        destroy = function()
            for id in pairs(INFO) do INFO[id] = nil end
            pcall(function() gui:Destroy() end)
        end,
    }
end

