-- ------------------------------------------------------------
-- HTTP com fallback
-- ------------------------------------------------------------
local function httpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" and #res > 0 then return res end
    local req = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
    if req then
        local ok2, r = pcall(req, { Url = url, Method = "GET" })
        if ok2 and type(r) == "table" and type(r.Body) == "string" and #r.Body > 0
            and (r.Success == true or r.StatusCode == 200) then
            return r.Body
        end
    end
    error("HttpGet falhou: " .. tostring(res))
end

-- ------------------------------------------------------------
-- Drawing fallback (Instances) - so se o executor nao tiver Drawing
-- ------------------------------------------------------------
local function buildDrawingShim()
    if env.__VX_DRAW_HOST then pcall(function() env.__VX_DRAW_HOST:Destroy() end) end

    local host = Instance.new("ScreenGui")
    host.Name = "VX_Draw"
    host.ResetOnSpawn = false
    host.IgnoreGuiInset = true
    host.DisplayOrder = 2147483647
    host.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    if syn and syn.protect_gui then pcall(syn.protect_gui, host) end
    if not mount(host, false) then return nil end
    env.__VX_DRAW_HOST = host

    local WHITE = Color3.new(1, 1, 1)
    local BLACK = Color3.new(0, 0, 0)
    local FONT = {
        [0] = Enum.Font.Gotham, [1] = Enum.Font.SourceSans,
        [2] = Enum.Font.RobotoMono, [3] = Enum.Font.Code,
    }

    local function proxy(d, set, destroy, extra)
        local alive = true
        return setmetatable({}, {
            __index = function(_, k)
                if k == "Remove" or k == "Destroy" then
                    return function()
                        if alive then
                            alive = false
                            destroy()
                        end
                    end
                end
                if extra then
                    local v = extra(k)
                    if v ~= nil then return v end
                end
                return d[k]
            end,
            __newindex = function(_, k, v)
                if not alive or d[k] == v then return end
                d[k] = v
                set(k)
            end,
        })
    end

    local function newFrame()
        local f = Instance.new("Frame")
        f.BorderSizePixel = 0
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Visible = false
        return f
    end

    local function placeLine(f, a, b, thickness)
        local dx, dy = b.X - a.X, b.Y - a.Y
        f.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), thickness)
        f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
        f.Rotation = math.deg(math.atan2(dy, dx))
    end

    local function square()
        local d = { Visible = false, Color = WHITE, Transparency = 1, Thickness = 1, Filled = false,
            Position = Vector2.zero, Size = Vector2.zero }
        local f = Instance.new("Frame")
        f.BorderSizePixel = 0
        f.BackgroundTransparency = 1
        f.Visible = false
        local st = Instance.new("UIStroke")
        st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        st.Parent = f
        f.Parent = host
        local function paint()
            f.BackgroundColor3 = d.Color
            f.BackgroundTransparency = d.Filled and (1 - d.Transparency) or 1
            st.Enabled = not d.Filled
            st.Color = d.Color
            st.Thickness = d.Thickness
            st.Transparency = 1 - d.Transparency
        end
        paint()
        local function set(k)
            if k == "Visible" then f.Visible = d.Visible
            elseif k == "Position" then f.Position = UDim2.fromOffset(d.Position.X, d.Position.Y)
            elseif k == "Size" then f.Size = UDim2.fromOffset(d.Size.X, d.Size.Y)
            else paint() end
        end
        return proxy(d, set, function() f:Destroy() end)
    end

    local function line()
        local d = { Visible = false, Color = WHITE, Transparency = 1, Thickness = 1,
            From = Vector2.zero, To = Vector2.zero }
        local f = newFrame()
        f.Parent = host
        local function paint()
            f.BackgroundColor3 = d.Color
            f.BackgroundTransparency = 1 - d.Transparency
        end
        paint()
        local function set(k)
            if k == "Visible" then f.Visible = d.Visible
            elseif k == "To" or k == "Thickness" then placeLine(f, d.From, d.To, d.Thickness)
            elseif k == "From" then -- aguarda To
            else paint() end
        end
        return proxy(d, set, function() f:Destroy() end)
    end

    local function text()
        local d = { Visible = false, Color = WHITE, Transparency = 1, Size = 13, Text = "",
            Center = false, Outline = false, OutlineColor = BLACK, Font = 2, Position = Vector2.zero }
        local t = Instance.new("TextLabel")
        t.BackgroundTransparency = 1
        t.BorderSizePixel = 0
        t.AutomaticSize = Enum.AutomaticSize.XY
        t.Size = UDim2.fromOffset(0, 0)
        t.TextXAlignment = Enum.TextXAlignment.Left
        t.TextYAlignment = Enum.TextYAlignment.Top
        t.TextWrapped = false
        t.Visible = false
        t.Parent = host
        local function paint()
            t.Text = d.Text
            t.TextSize = d.Size
            t.Font = FONT[d.Font] or Enum.Font.Code
            t.TextColor3 = d.Color
            t.TextTransparency = 1 - d.Transparency
            t.TextStrokeColor3 = d.OutlineColor
            t.TextStrokeTransparency = d.Outline and 0 or 1
            t.AnchorPoint = Vector2.new(d.Center and 0.5 or 0, 0)
        end
        paint()
        local function set(k)
            if k == "Visible" then t.Visible = d.Visible
            elseif k == "Position" then t.Position = UDim2.fromOffset(d.Position.X, d.Position.Y)
            elseif k == "Text" then t.Text = d.Text
            else paint() end
        end
        return proxy(d, set, function() t:Destroy() end, function(k)
            if k == "TextBounds" then
                local ok, v = pcall(TextService.GetTextSize, TextService, d.Text, d.Size,
                    FONT[d.Font] or Enum.Font.Code, Vector2.new(10000, 10000))
                return ok and v or Vector2.zero
            end
        end)
    end

    local function circle()
        local d = { Visible = false, Color = WHITE, Transparency = 1, Thickness = 1, Filled = false,
            NumSides = 64, Radius = 0, Position = Vector2.zero }
        local f = newFrame()
        f.BackgroundTransparency = 1
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = f
        local st = Instance.new("UIStroke")
        st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        st.Parent = f
        f.Parent = host
        local function paint()
            f.BackgroundColor3 = d.Color
            f.BackgroundTransparency = d.Filled and (1 - d.Transparency) or 1
            st.Enabled = not d.Filled
            st.Color = d.Color
            st.Thickness = d.Thickness
            st.Transparency = 1 - d.Transparency
        end
        paint()
        local function set(k)
            if k == "Visible" then f.Visible = d.Visible
            elseif k == "Position" then f.Position = UDim2.fromOffset(d.Position.X, d.Position.Y)
            elseif k == "Radius" then f.Size = UDim2.fromOffset(d.Radius * 2, d.Radius * 2)
            else paint() end
        end
        return proxy(d, set, function() f:Destroy() end)
    end

    local function triangle()
        local d = { Visible = false, Color = WHITE, Transparency = 1, Thickness = 1, Filled = false,
            PointA = Vector2.zero, PointB = Vector2.zero, PointC = Vector2.zero }
        local e = {}
        for i = 1, 3 do
            e[i] = newFrame()
            e[i].Parent = host
        end
        local function paint()
            for _, f in ipairs(e) do
                f.BackgroundColor3 = d.Color
                f.BackgroundTransparency = 1 - d.Transparency
            end
        end
        local function geom()
            placeLine(e[1], d.PointA, d.PointB, d.Thickness)
            placeLine(e[2], d.PointB, d.PointC, d.Thickness)
            placeLine(e[3], d.PointC, d.PointA, d.Thickness)
        end
        paint()
        local function set(k)
            if k == "Visible" then
                for _, f in ipairs(e) do f.Visible = d.Visible end
            elseif k == "PointC" or k == "Thickness" then geom()
            elseif k == "PointA" or k == "PointB" then -- aguarda PointC
            else paint() end
        end
        return proxy(d, set, function()
            for _, f in ipairs(e) do f:Destroy() end
        end)
    end

    local ctors = { Square = square, Line = line, Text = text, Circle = circle, Triangle = triangle }
    local D = { Fonts = { UI = 0, System = 1, Plex = 2, Monospace = 3 } }
    function D.new(kind)
        local c = ctors[kind]
        if not c then error("Drawing.new: tipo invalido " .. tostring(kind), 2) end
        return c()
    end
    function D.clear() end
    return D
end

local function drawingWorks()
    local D = env.Drawing or Drawing
    if type(D) ~= "table" or type(D.new) ~= "function" then return false end
    for _, kind in ipairs({ "Square", "Line", "Text", "Circle" }) do
        local ok, o = pcall(D.new, kind)
        if not ok or o == nil then return false end
        pcall(function() o.Visible = false end)
        pcall(function() o:Remove() end)
    end
    return true
end

