local marks = {}

local function clearMark(plr)
    local m = marks[plr]
    if m then
        pcall(function() m.hl:Destroy() end)
        pcall(function() m.bb:Destroy() end)
        marks[plr] = nil
    end
end

local function clearAll()
    for plr in pairs(marks) do clearMark(plr) end
end

local function ensureMark(plr, char)
    local m = marks[plr]
    if m and m.char == char and m.hl.Parent and m.bb.Parent then return m end
    clearMark(plr)
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not head then return nil end

    local hl = Instance.new("Highlight")
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 0.6
    hl.Adornee = char
    hl.Parent = workspace.CurrentCamera or workspace

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(170, 28)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = head
    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.fromScale(1, 1)
    tl.BackgroundTransparency = 1
    tl.Font = Enum.Font.GothamBold
    tl.TextSize = 14
    tl.TextStrokeTransparency = 0
    tl.Parent = bb
    bb.Parent = head

    m = { char = char, hl = hl, bb = bb, tl = tl }
    marks[plr] = m
    return m
end

-- Coin ESP (small dots; Highlight is limited to ~31 active)
local coinMarks = {}
local function clearCoinMarks()
    for p, bb in pairs(coinMarks) do
        pcall(function() bb:Destroy() end)
        coinMarks[p] = nil
    end
end

local function updateCoinEsp()
    if not S.coinEsp then
        if next(coinMarks) then clearCoinMarks() end
        return
    end
    local cont = coinContainer()
    if not cont then return end
    for _, c in ipairs(cont:GetDescendants()) do
        if c:IsA("BasePart") and c.Name == "Coin_Server" and not coinMarks[c] then
            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.fromOffset(8, 8)
            bb.AlwaysOnTop = true
            bb.Adornee = c
            local f = Instance.new("Frame")
            f.Size = UDim2.fromScale(1, 1)
            f.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
            f.BorderSizePixel = 0
            local cr = Instance.new("UICorner")
            cr.CornerRadius = UDim.new(1, 0)
            cr.Parent = f
            f.Parent = bb
            bb.Parent = c
            coinMarks[c] = bb
        end
    end
    for c, bb in pairs(coinMarks) do
        if not c.Parent then
            pcall(function() bb:Destroy() end)
            coinMarks[c] = nil
        end
    end
end

-- Dropped gun lookup. The drop is not necessarily a direct child of the workspace (it can sit inside the
-- map model), so it is found with one scan at start plus DescendantAdded, instead of a root-level lookup.
local function insideCharacter(inst)
    local p = inst.Parent
    while p and p ~= workspace do
        if p:IsA("Model") and Players:GetPlayerFromCharacter(p) then return true end
        p = p.Parent
    end
    return false
end

local function isGunDrop(inst)
    if inst.Name == "GunDrop" then return true end
    return inst.Name == "Gun" and inst:IsA("Tool") and not insideCharacter(inst)   -- a gun Tool lying on the map
end

local gunDropCache
for _, d in ipairs(workspace:GetDescendants()) do
    if isGunDrop(d) then gunDropCache = d end
end
track(workspace.DescendantAdded:Connect(function(d)
    if isGunDrop(d) then gunDropCache = d end
end))

local function findGunDrop()
    if gunDropCache and gunDropCache.Parent and gunDropCache:IsDescendantOf(workspace) then return gunDropCache end
    gunDropCache = nil
    return nil
end

-- the part to touch / highlight for a drop (a Part, a Model, or a Tool with a Handle)
local function gunDropPart(drop)
    if not drop then return nil end
    if drop:IsA("BasePart") then return drop end
    return drop:FindFirstChildWhichIsA("BasePart", true)
end

-- names of gun-like objects on the map, shown when Grab Gun finds nothing (helps spotting a different name)
local function gunCandidates()
    local names, seen = {}, {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if d.Name:lower():find("gun") and not insideCharacter(d) then
            local label = d.Name .. " (" .. d.ClassName .. ")"
            if not seen[label] then
                seen[label] = true
                names[#names + 1] = label
                if #names >= 6 then break end
            end
        end
    end
    return names
end

-- Dropped gun ESP
local gunHl
local function updateGunEsp()
    local drop = findGunDrop()
    local target = drop and (drop:IsA("PVInstance") and drop or gunDropPart(drop))
    if S.gunEsp and target then
        if not gunHl or not gunHl.Parent then
            gunHl = Instance.new("Highlight")
            gunHl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            gunHl.FillColor = Color3.fromRGB(255, 215, 0)
            gunHl.OutlineColor = Color3.fromRGB(255, 215, 0)
            gunHl.FillTransparency = 0.3
            gunHl.Parent = workspace.CurrentCamera or workspace
        end
        gunHl.Adornee = target
    elseif gunHl then
        pcall(function() gunHl:Destroy() end)
        gunHl = nil
    end
end

-- Lighting
local fbOrig
local function applyLighting()
    if not S.fullbright then
        if fbOrig then
            for k, v in pairs(fbOrig) do
                pcall(function() Lighting[k] = v end)
            end
            fbOrig = nil
        end
        return
    end
    fbOrig = fbOrig or {
        Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
        GlobalShadows = Lighting.GlobalShadows, Ambient = Lighting.Ambient,
    }
    Lighting.Brightness = 2
    Lighting.ClockTime = 14
