local function cycleSelected(step)
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then list[#list + 1] = plr end
    end
    table.sort(list, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
    if #list == 0 then
        FLING.sel = nil
        showSelected()
        return
    end
    local idx = 0
    for i, plr in ipairs(list) do
        if plr == FLING.sel then idx = i break end
    end
    if idx == 0 then idx = (step > 0) and 1 or #list else idx = ((idx - 1 + step) % #list) + 1 end
    FLING.sel = list[idx]
    S.flingPick = playerLabel(FLING.sel)
    showSelected()
end

local function flingSelected()
    if not (FLING.sel and FLING.sel.Parent) then
        notify("Pick a player first (Next Player)")
        return
    end
    flingAndReport(FLING.sel)
end

