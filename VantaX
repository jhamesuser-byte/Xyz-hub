            gunHl.FillTransparency = 0.3
            gunHl.Parent = workspace.CurrentCamera or workspace
        end
        gunHl.Adornee = target
    elseif gunHl then
        pcall(function() gunHl:Destroy() end)
        gunHl = nil
    end
end

