local function addCycle(p, label, key, options, onChange)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 30)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.BackgroundColor3 = DARK
    b.LayoutOrder = slot(p)
    roundify(b)
    local function paint() b.Text = label .. ": " .. tostring(S[key]) end
    paint()
    b.Activated:Connect(function()
        local idx = 1
        for i, o in ipairs(options) do
            if o == S[key] then idx = i end
        end
        S[key] = options[(idx % #options) + 1]
        if onChange then pcall(onChange, S[key]) end
        paint()
    end)
    b.Parent = p.frame
end

local function addStepper(p, label, key, mn, mx, step, onChange)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 30)
    row.BackgroundColor3 = DARK
    row.BorderSizePixel = 0
    row.LayoutOrder = slot(p)
    roundify(row)
    local lb = Instance.new("TextLabel")
    lb.Size = UDim2.new(1, -70, 1, 0)
    lb.Position = UDim2.fromOffset(8, 0)
    lb.BackgroundTransparency = 1
    lb.TextColor3 = Color3.new(1, 1, 1)
    lb.Font = Enum.Font.GothamBold
    lb.TextSize = 12
    lb.TextXAlignment = Enum.TextXAlignment.Left
    lb.Parent = row
    local function paint() lb.Text = label .. ": " .. tostring(S[key]) end
    paint()
    local function bump(dir)
        S[key] = math.clamp(S[key] + dir * step, mn, mx)
        paint()
        if onChange then pcall(onChange, S[key]) end
    end
    local function mk(text, x, dir)
        local b = Instance.new("TextButton")
        b.Size = UDim2.fromOffset(28, 24)
        b.Position = UDim2.new(1, x, 0.5, -12)
        b.BackgroundColor3 = PURPLE
        b.TextColor3 = Color3.new(1, 1, 1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 16
        b.Text = text
        roundify(b, 6)
        b.Activated:Connect(function() bump(dir) end)
        b.Parent = row
    end
    mk("-", -62, -1)
    mk("+", -32, 1)
end

