local function replacePlain(src, old, new, all)
    local out, pos, n = {}, 1, 0
    while true do
        local s, e = string.find(src, old, pos, true)
        if not s then break end
        out[#out + 1] = string.sub(src, pos, s - 1)
        out[#out + 1] = new
        pos = e + 1
        n = n + 1
        if not all then break end
    end
    out[#out + 1] = string.sub(src, pos)
    return table.concat(out), n
end

say("4/6 baixando o VantaX...")
local okFetch, src = pcall(httpGet, SRC_URL)
if not okFetch then
    fail("download do VantaX: " .. tostring(src))
    return
end

local patched = src
for _, p in ipairs(PATCHES) do
    local out, n = replacePlain(patched, p.old, p.new, p.all)
    if n == 0 then
        say("patch NAO aplicado: " .. p.name)
    else
        patched = out
    end
end

local chunk, err = loadstring(PRELUDE .. patched, "=VantaX")
if not chunk then
    say("versao corrigida nao compilou, usando a original")
    chunk, err = loadstring(PRELUDE .. src, "=VantaX")
end
if not chunk then
    fail("compilar o VantaX: " .. tostring(err))
    return
end

say("5/6 executando o VantaX...")
local okRun, runErr = xpcall(chunk, function(e) return debug.traceback(tostring(e), 2) end)
if not okRun then
    fail("executar o VantaX: " .. tostring(runErr))
    return
end

local w = env.__VORTEX_HUB_WINDOW
if not w then
    fail("o VantaX rodou mas nao criou a janela (Slate nao carregou?)")
    return
end

if SHOW_MENU_ON_LOAD then
    task.delay(0.5, function() pcall(function() w:SetVisible(true) end) end)
end
addDock(w)
say("6/6 VantaX carregou. VX = abre/fecha o menu | LT = menu lite")
task.delay(25, hideLog)

pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "VantaX",
        Text = "Drawing: " .. drawMode .. " | Silent Aim: " .. (silentOk and "ok" or "indisponivel"),
        Duration = 8,
    })
end)
