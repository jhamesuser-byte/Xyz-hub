-- Iluminacao
local fbOrig
local function applyLighting()
    if not (S.fullbright or S.nofog) then
        if fbOrig then
            for k, v in pairs(fbOrig) do
                pcall(function() Lighting[k] = v end)
            end
            fbOrig = nil
        end
        return
    end
    fbOrig = fbOrig or {
        Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
        GlobalShadows = Lighting.GlobalShadows, FogEnd = Lighting.FogEnd, Ambient = Lighting.Ambient,
    }
    if S.fullbright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.new(1, 1, 1)
    end
    if S.nofog then Lighting.FogEnd = 1e6 end
end

local info -- label do menu (criado abaixo)
local lastMurd, lastSher

local function refresh()
    local murd, sher
    local _, _, myRoot = myParts()
    for _, plr in ipairs(Players:GetPlayers()) do
        local role = roleOf(plr)
        ROLE[plr] = role
        if role == "Assassino" then murd = plr elseif role == "Xerife" then sher = plr end

        if plr ~= lp then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if S.esp and char and hum and hum.Health > 0 then
                local m = ensureMark(plr, char)
                if m then
                    local col = COLORS[role]
                    m.hl.FillColor = col
                    m.hl.OutlineColor = col
                    m.tl.TextColor3 = col
                    local txt = plr.DisplayName .. " | " .. role
                    if S.dist and myRoot then
                        local r = char:FindFirstChild("HumanoidRootPart")
                        if r then txt = txt .. " | " .. math.floor((r.Position - myRoot.Position).Magnitude) .. "m" end
                    end
                    m.tl.Text = txt
                    m.bb.Enabled = S.labels
                end
            else
                clearMark(plr)
            end
        end
    end

    if S.notify then
        if murd and murd ~= lastMurd then notify("Assassino: " .. murd.DisplayName) end
        if sher and sher ~= lastSher then notify("Xerife: " .. sher.DisplayName) end
    end
    lastMurd, lastSher = murd, sher

    if info then
        info.Text = "Assassino: " .. (murd and murd.DisplayName or "?")
            .. "\nXerife: " .. (sher and sher.DisplayName or "?")
            .. "\nSeu papel: " .. roleOf(lp)
    end
    updateCoinEsp()
    updateGunEsp()
    applyLighting()
end

