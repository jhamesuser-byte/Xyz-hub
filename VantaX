local PARTS = {
    Head = { "Head" },
    Torso  = { "UpperTorso", "Torso", "HumanoidRootPart" },
}

local function partOf(char, key)
    for _, n in ipairs(PARTS[key] or PARTS.Head) do
        local p = char:FindFirstChild(n)
        if p and p:IsA("BasePart") then return p end
    end
    return char:FindFirstChild("HumanoidRootPart")
end

-- set by "Shoot Murderer": forces the target role regardless of the Target setting
local FORCE = { role = nil, target = nil, part = nil }   -- target: part the camera is held on during a forced shot; part: fixed aim part

-- Auto Shoot state (sheriff). active = a shot is being held, fireAt = when the trigger is pulled,
-- endAt = when the forced aim is released, nextShot = earliest time of the next shot
local AUTO = { active = false, fireAt = nil, endAt = 0, nextShot = 0, lastEquip = 0 }

local function endAutoShot()
    AUTO.active, AUTO.fireAt = false, nil
    FORCE.role, FORCE.part, FORCE.target = nil, nil, nil
end

local function wantRole(role, myRole)
    if FORCE.role then return FORCE.role == "Any" or role == FORCE.role end
    local a = CFG.target
    if a == "All" then return true end
    if a == "Murderer" then return role == "Murderer" end
    if a == "Sheriff" then return role == "Sheriff" end
    -- Auto: the murderer targets everyone; everyone else targets the murderer
    if myRole == "Murderer" then return true end
    return role == "Murderer"
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- dot-call (workspace.Raycast(workspace, ...)) does not go through the __namecall hook
local function visible(cam, part, char)
    local origin = cam.CFrame.Position
    local dir = part.Position - origin
    local ignore = { lp.Character, char, cam }
    rayParams.FilterDescendantsInstances = ignore
    -- a hit on a non-collidable or (almost) transparent part does not block the shot: skip it and continue
    for _ = 1, 8 do
        local hit = workspace.Raycast(workspace, origin, dir, rayParams)
        if not hit then return true end
        local inst = hit.Instance
        if inst and (inst.CanCollide == false or inst.Transparency >= 0.8) then
            ignore[#ignore + 1] = inst
            rayParams.FilterDescendantsInstances = ignore
        else
            return false
        end
    end
    return false
end

local function pickTarget(fov, maxDist, partKey, wall)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local _, myHum = myParts()
    if not myHum or myHum.Health <= 0 then return nil end
    local myRole = roleOf(lp)
    local center = cam.ViewportSize / 2
    local camPos = cam.CFrame.Position
    local bestPart, bestPlr
    local bestKey = math.huge
    local anywhere = (fov == math.huge)   -- forced shot: no on-screen requirement, closest wins
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if char and hum and hum.Health > 0 and wantRole(FORCE.role and roleOf(plr) or roleCached(plr), myRole) then
                local part = partOf(char, partKey)
                if part then
                    local dist = (part.Position - camPos).Magnitude
                    if dist <= maxDist then
                        local sp, on = cam:WorldToViewportPoint(part.Position)
                        if anywhere or (on and sp.Z > 0) then
                            local dd = anywhere and dist or (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if dd <= fov then
                                local key = (anywhere or CFG.prio == "Closest") and dist or dd
                                if key < bestKey and ((not wall) or visible(cam, part, char)) then
                                    bestKey, bestPart, bestPlr = key, part, plr
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if not bestPart then return nil end
    return bestPart, bestPart.Position, bestPlr
end

-- sticky lock: keep the current target until he dies, hides, goes out of range or leaves 1.6x the FOV
local function holdTarget(cam, part, fov)
    if not (part and part.Parent) then return false end
    local char = part.Parent
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local sp, on = cam:WorldToViewportPoint(part.Position)
    if not on or sp.Z <= 0 then return false end
    if (Vector2.new(sp.X, sp.Y) - cam.ViewportSize / 2).Magnitude > fov * 1.6 then return false end
    if (part.Position - cam.CFrame.Position).Magnitude > CFG.maxDist then return false end
    local plr = Players:GetPlayerFromCharacter(char)
    if not plr or not wantRole(roleCached(plr), roleOf(lp)) then return false end
    if CFG.wall and not visible(cam, part, char) then return false end
    return true
end

